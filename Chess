  pushQuad(p[0], p[4], p[7], p[3], r * 0.86, g * 0.86, b * 0.86);
  pushQuad(p[5], p[1], p[2], p[6], r * 0.86, g * 0.86, b * 0.86);
  pushQuad(p[7], p[6], p[2], p[3], r * 1.12, g * 1.12, b * 1.12);
