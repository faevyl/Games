    <button type="button" data-eng="house">HOUSE</button>
    <button type="button" data-eng="gambit">GAMBIT</button>
  </div>
  <div id="colors">
    <button type="button" data-color="1" class="on">AI BLACK</button>
    <button type="button" data-color="0">AI WHITE</button>
  </div>
  <button type="button" id="aitog" class="on">AI ON · BLACK</button>
  <div id="sfstat">house engine · positional</div>
</div>
<div id="hud">pick a cream piece, then a square</div>
<div id="err"></div>
<script>
window.onerror = function (msg, src, line) {
  var el = document.getElementById('err');
  el.style.display = 'block';
  el.textContent = msg + '\n' + src + ':' + line;
};

var canvas = document.getElementById('c');
var ctx = canvas.getContext('2d');
var ui = document.getElementById('ui');
var hud = document.getElementById('hud');
var turnEl = document.getElementById('turn');
var sideEl = document.getElementById('side');
var eloNum = document.getElementById('elonum');
var eloSlider = document.getElementById('eloslider');
var eloPresets = document.getElementById('elopresets');
var aiTog = document.getElementById('aitog');
var sfStat = document.getElementById('sfstat');
canvas.tabIndex = 0;

try {
  if (window.self !== window.top) document.documentElement.className = 'embed';
} catch (e) {
  document.documentElement.className = 'embed';
}

var W = 0, H = 0;
function resize() {
  var vw = window.innerWidth;
  var vh = window.innerHeight;
  if (window.visualViewport) {
    vw = window.visualViewport.width;
    vh = window.visualViewport.height;
  }
  W = canvas.width = Math.max(1, vw | 0);
  H = canvas.height = Math.max(1, vh | 0);
}
window.addEventListener('resize', resize);
if (window.visualViewport) window.visualViewport.addEventListener('resize', resize);
resize();

var SQ = 1.22;
var FOV = 58 * Math.PI / 180;
var started = false;
var vsAI = true;
var aiElo = 1200;
var engineMode = 'house';
var aiColor = 1;
var lastGambit = '';
var sparks = [];
var screenFx = null;
var hintMove = null;
var hintKey = '';
var nextId = 1;
var time = 0;

var cam = { x: 0, y: 10.6, z: -10.3 };
var look = { x: 0, y: 0.4, z: 0 };
var orbit = { yaw: Math.PI, pitch: 0.78, dist: 14.5 };
var focus = { x: 0, y: 0.35, z: 0 };
var wantFocus = { x: 0, y: 0.35, z: 0 };
var basis = { fx: 0, fy: 0, fz: 1, rx: 1, ry: 0, rz: 0, ux: 0, uy: 1, uz: 0 };

var board, turn, castle, ep, selected, legal, hover, anims, fallen, over, lastMove, checkPulse;
var dragging = false, lastMX = 0, lastMY = 0;
var keys = {};
var uciMoves = [];
var gameToken = 0;

function applySideCam() {
  var user = vsAI ? (1 - aiColor) : 0;
  if (user === 0) {
    orbit.yaw = Math.PI;
    cam.x = 0; cam.y = 10.6; cam.z = -10.3;
  } else {
    orbit.yaw = 0;
    cam.x = 0; cam.y = 10.6; cam.z = 10.3;
  }
}

var GAMBIT_BOOK = [
  { name: "King's Gambit", moves: ['e2e4', 'e7e5', 'f2f4'] },
  { name: "King's Gambit Accepted", moves: ['e2e4', 'e7e5', 'f2f4', 'e5f4', 'g1f3'] },
  { name: "Bishop's Gambit", moves: ['e2e4', 'e7e5', 'f2f4', 'e5f4', 'f1c4'] },
  { name: "Danish Gambit", moves: ['e2e4', 'e7e5', 'd2d4', 'e5d4', 'c2c3'] },
  { name: "Danish Gambit Accepted", moves: ['e2e4', 'e7e5', 'd2d4', 'e5d4', 'c2c3', 'd4c3', 'f1c4'] },
  { name: "Evans Gambit", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1c4', 'f8c5', 'b2b4'] },
  { name: "Evans Gambit Accepted", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1c4', 'f8c5', 'b2b4', 'c5b4', 'c2c3'] },
  { name: "Scotch Gambit", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'd2d4', 'e5d4', 'f1c4'] },
  { name: "Goring Gambit", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'd2d4', 'e5d4', 'c2c3'] },
  { name: "Vienna Gambit", moves: ['e2e4', 'e7e5', 'b1c3', 'g8f6', 'f2f4'] },
  { name: "Smith-Morra", moves: ['e2e4', 'c7c5', 'd2d4', 'c5d4', 'c2c3'] },
  { name: "Smith-Morra Accepted", moves: ['e2e4', 'c7c5', 'd2d4', 'c5d4', 'c2c3', 'd4c3', 'b1c3'] },
  { name: "Wing Gambit", moves: ['e2e4', 'c7c5', 'b2b4'] },
  { name: "Blackmar-Diemer", moves: ['d2d4', 'd7d5', 'e2e4', 'd5e4', 'b1c3', 'g8f6', 'f2f3'] },
  { name: "Staunton Gambit", moves: ['d2d4', 'f7f5', 'e2e4'] },
  { name: "Queen's Gambit", moves: ['d2d4', 'd7d5', 'c2c4'] },
  { name: "Budapest", moves: ['d2d4', 'g8f6', 'c2c4', 'e7e5'] },
  { name: "Albin Countergambit", moves: ['d2d4', 'd7d5', 'c2c4', 'e7e5'] },
  { name: "Englund Gambit", moves: ['d2d4', 'e7e5'] },
  { name: "Latvian Gambit", moves: ['e2e4', 'e7e5', 'g1f3', 'f7f5'] },
  { name: "Elephant Gambit", moves: ['e2e4', 'e7e5', 'g1f3', 'd7d5'] },
  { name: "Falkbeer", moves: ['e2e4', 'e7e5', 'f2f4', 'd7d5'] },
  { name: "Benko Gambit", moves: ['d2d4', 'g8f6', 'c2c4', 'c7c5', 'd4d5', 'b7b5'] },
  { name: "Traxler", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1c4', 'g8f6', 'f3g5', 'f8c5'] },
  { name: "Marshall Attack", moves: ['e2e4', 'e7e5', 'g1f3', 'b8c6', 'f1b5', 'a7a6', 'b5a4', 'g8f6', 'e1g1', 'f8e7', 'f1e1', 'b7b5', 'a4b3', 'e8g8', 'c2c3', 'd7d5'] }
];

function bookReply() {
  var matches = [], i, j, line, ok, next, mover;
  for (i = 0; i < GAMBIT_BOOK.length; i++) {
    line = GAMBIT_BOOK[i];
    if (line.moves.length <= uciMoves.length) continue;
    ok = true;
    for (j = 0; j < uciMoves.length; j++) {
      if (line.moves[j] !== uciMoves[j]) { ok = false; break; }
    }
    if (!ok) continue;
    mover = uciMoves.length % 2;
    if (mover !== aiColor) continue;
    next = line.moves[uciMoves.length];
    matches.push({ uci: next, name: line.name });
  }
  if (!matches.length) return null;
  var pick = matches[(Math.random() * matches.length) | 0];
  lastGambit = pick.name;
  return uciToMove(pick.uci);
}

function evalGambit(b, color) {
  var s = 0, r, f, p, ek, home, dist, w = 0.55;
  var GVAL = { p: 70, n: 280, b: 290, r: 430, q: 820, k: 0 };
  for (r = 0; r < 8; r++) for (f = 0; f < 8; f++) {
    p = b[r][f];
    if (!p) continue;
    home = p.c === 0 ? 0 : 7;
    s += (p.c === color ? 1 : -1) * (GVAL[p.t] + pstAt(p.t, p.c, f, r) * w);
    if (p.t !== 'p' && p.t !== 'k' && r !== home) s += (p.c === color ? 1 : -1) * 22;
    if ((p.t === 'n' || p.t === 'b') && Math.abs(r - home) >= 2) s += (p.c === color ? 1 : -1) * 12;
  }
  ek = kingSq(b, 1 - color);
  if (ek) {
    home = (1 - color) === 0 ? 0 : 7;
    if (ek.r !== home) s += 28;
    if (ek.f >= 2 && ek.f <= 5 && ek.r >= 2 && ek.r <= 5) s += 36;
    for (r = 0; r < 8; r++) for (f = 0; f < 8; f++) {
      p = b[r][f];
      if (!p || p.c !== color || p.t === 'k') continue;
      dist = Math.abs(f - ek.f) + Math.abs(r - ek.r);
      if (dist <= 3) s += p.t === 'q' || p.t === 'n' ? 16 : 10;
      if ((1 - color) === 0 && r <= 2 && (f === 5 || f === 6)) s += 8;
      if ((1 - color) === 1 && r >= 5 && (f === 5 || f === 6)) s += 8;
    }
  }
  if (inCheck(b, 1 - color)) s += 70;
  if (inCheck(b, color)) s -= 40;
  return s;
}

function sqWorld(f, r) {
  return { x: (f - 3.5) * SQ, z: (r - 3.5) * SQ };
}

function worldSq(x, z) {
  return { f: Math.round(x / SQ + 3.5), r: Math.round(z / SQ + 3.5) };
}

function pieceAt(f, r) {
  if (f < 0 || r < 0 || f > 7 || r > 7) return null;
  return board[r][f];
}

function makePiece(t, c, f, r) {
  var p = { t: t, c: c, f: f, r: r, id: nextId++, yaw: c === 0 ? 0 : Math.PI, vx: 0, vz: 0, y: 0, walk: 0, squash: 1, dead: 0, lean: 0, spin: 0 };
  var w = sqWorld(f, r);
  p.x = w.x; p.z = w.z;
  return p;
}

function setupBoard() {
  var r, f, back = ['r', 'n', 'b', 'q', 'k', 'b', 'n', 'r'];
  board = [];
  nextId = 1;
  for (r = 0; r < 8; r++) {
    board[r] = [];
    for (f = 0; f < 8; f++) board[r][f] = null;
  }
  for (f = 0; f < 8; f++) {
    board[0][f] = makePiece(back[f], 0, f, 0);
    board[1][f] = makePiece('p', 0, f, 1);
    board[6][f] = makePiece('p', 1, f, 6);
    board[7][f] = makePiece(back[f], 1, f, 7);
  }
  turn = 0;
  castle = { 0: { k: 1, q: 1 }, 1: { k: 1, q: 1 } };
  ep = null;
  selected = null;
  legal = [];
  hover = null;
  anims = [];
  fallen = [];
  over = null;
  lastMove = null;
  checkPulse = 0;
  wantFocus.x = 0; wantFocus.z = 0;
  lastGambit = '';
  uciMoves = [];
  gameToken++;
  sparks = [];
  screenFx = null;
  hintMove = null;
  hintKey = '';
  applySideCam();
}

function cloneState() {
  var r, f, nb = [];
  for (r = 0; r < 8; r++) {
    nb[r] = [];
    for (f = 0; f < 8; f++) {
      var p = board[r][f];
      nb[r][f] = p ? { t: p.t, c: p.c, id: p.id } : null;
    }
  }
  return {
    board: nb,
    turn: turn,
    castle: { 0: { k: castle[0].k, q: castle[0].q }, 1: { k: castle[1].k, q: castle[1].q } },
    ep: ep ? { f: ep.f, r: ep.r } : null
  };
}

function kingSq(b, color) {
  var r, f;
  for (r = 0; r < 8; r++) for (f = 0; f < 8; f++) {
    if (b[r][f] && b[r][f].t === 'k' && b[r][f].c === color) return { f: f, r: r };
  }
  return null;
}

function slideHits(b, f, r, df, dr, color, acc) {
  var i, nf = f + df, nr = r + dr, q;
  for (i = 0; i < 8; i++) {
    if (nf < 0 || nr < 0 || nf > 7 || nr > 7) return;
    q = b[nr][nf];
    if (!q) acc.push({ f: nf, r: nr });
    else {
      if (q.c !== color) acc.push({ f: nf, r: nr, cap: 1 });
      return;
    }
    nf += df; nr += dr;
  }
}

function squareAttacked(b, f, r, by) {
  var df, dr, nf, nr, i, q, kn = [[1, 2], [2, 1], [-1, 2], [-2, 1], [1, -2], [2, -1], [-1, -2], [-2, -1]];
  var dirsB = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
  var dirsR = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  var pr = r - (by === 0 ? 1 : -1);
  if (pr >= 0 && pr < 8) {
    if (f > 0) {
      q = b[pr][f - 1];
      if (q && q.c === by && q.t === 'p') return true;
    }
    if (f < 7) {
      q = b[pr][f + 1];
      if (q && q.c === by && q.t === 'p') return true;
    }
  }
  for (i = 0; i < 8; i++) {
    nf = f + kn[i][0]; nr = r + kn[i][1];
    if (nf < 0 || nr < 0 || nf > 7 || nr > 7) continue;
    q = b[nr][nf];
    if (q && q.c === by && q.t === 'n') return true;
  }
  for (i = 0; i < 4; i++) {
    nf = f + dirsB[i][0]; nr = r + dirsB[i][1];
    while (nf >= 0 && nr >= 0 && nf < 8 && nr < 8) {
      q = b[nr][nf];
      if (q) { if (q.c === by && (q.t === 'b' || q.t === 'q')) return true; break; }
      nf += dirsB[i][0]; nr += dirsB[i][1];
    }
  }
  for (i = 0; i < 4; i++) {
    nf = f + dirsR[i][0]; nr = r + dirsR[i][1];
    while (nf >= 0 && nr >= 0 && nf < 8 && nr < 8) {
      q = b[nr][nf];
      if (q) { if (q.c === by && (q.t === 'r' || q.t === 'q')) return true; break; }
      nf += dirsR[i][0]; nr += dirsR[i][1];
    }
  }
  for (dr = -1; dr <= 1; dr++) for (df = -1; df <= 1; df++) {
    if (!df && !dr) continue;
    nf = f + df; nr = r + dr;
    if (nf < 0 || nr < 0 || nf > 7 || nr > 7) continue;
    q = b[nr][nf];
    if (q && q.c === by && q.t === 'k') return true;
  }
  return false;
}

function inCheck(b, color) {
  var k = kingSq(b, color);
  if (!k) return true;
  return squareAttacked(b, k.f, k.r, 1 - color);
}

function pseudoMoves(b, color, cst, epSq) {
  var r, f, p, acc, dir, start, nf, nr, i, q;
  var moves = [];
  var kn = [[1, 2], [2, 1], [-1, 2], [-2, 1], [1, -2], [2, -1], [-1, -2], [-2, -1]];
  var dirsB = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
  var dirsR = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  function add(ff, rr, extra) {
    var m = { f0: f, r0: r, f1: ff, r1: rr };
    if (extra) { for (var k in extra) m[k] = extra[k]; }
    moves.push(m);
  }
  for (r = 0; r < 8; r++) for (f = 0; f < 8; f++) {
    p = b[r][f];
    if (!p || p.c !== color) continue;
    if (p.t === 'p') {
      dir = color === 0 ? 1 : -1;
      start = color === 0 ? 1 : 6;
      nr = r + dir;
      if (nr >= 0 && nr < 8 && !b[nr][f]) {
        if (nr === 0 || nr === 7) add(f, nr, { promo: 'q' });
        else add(f, nr);
        if (r === start && !b[r + dir * 2][f]) add(f, r + dir * 2, { dpush: 1 });
      }
      if (f > 0 && nr >= 0 && nr < 8 && b[nr][f - 1] && b[nr][f - 1].c !== color) {
        add(f - 1, nr, nr === 0 || nr === 7 ? { promo: 'q' } : null);
      }
      if (f < 7 && nr >= 0 && nr < 8 && b[nr][f + 1] && b[nr][f + 1].c !== color) {
        add(f + 1, nr, nr === 0 || nr === 7 ? { promo: 'q' } : null);
      }
      if (epSq && nr === epSq.r && Math.abs(epSq.f - f) === 1) add(epSq.f, epSq.r, { ep: 1 });
    } else if (p.t === 'n') {
      for (i = 0; i < 8; i++) {
        nf = f + kn[i][0]; nr = r + kn[i][1];
        if (nf < 0 || nr < 0 || nf > 7 || nr > 7) continue;
        q = b[nr][nf];
        if (!q || q.c !== color) add(nf, nr);
      }
    } else if (p.t === 'b' || p.t === 'q') {
      acc = [];
      for (i = 0; i < 4; i++) slideHits(b, f, r, dirsB[i][0], dirsB[i][1], color, acc);
      for (i = 0; i < acc.length; i++) add(acc[i].f, acc[i].r);
      if (p.t === 'b') continue;
    }
    if (p.t === 'r' || p.t === 'q') {
      acc = [];
      for (i = 0; i < 4; i++) slideHits(b, f, r, dirsR[i][0], dirsR[i][1], color, acc);
      for (i = 0; i < acc.length; i++) add(acc[i].f, acc[i].r);
    }
    if (p.t === 'k') {
      for (nr = r - 1; nr <= r + 1; nr++) for (nf = f - 1; nf <= f + 1; nf++) {
        if (nf < 0 || nr < 0 || nf > 7 || nr > 7 || (nf === f && nr === r)) continue;
        q = b[nr][nf];
        if (!q || q.c !== color) add(nf, nr);
      }
      if (cst[color].k && !b[r][5] && !b[r][6] && b[r][7] && b[r][7].t === 'r') add(6, r, { castle: 'k' });
      if (cst[color].q && !b[r][1] && !b[r][2] && !b[r][3] && b[r][0] && b[r][0].t === 'r') add(2, r, { castle: 'q' });
    }
  }
  return moves;
}

