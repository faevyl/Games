function project(x, y, z) {
  var tx = x - cam.x, ty = y - cam.y, tz = z - cam.z;
  var cx = tx * basis.rx + ty * basis.ry + tz * basis.rz;
  var cy = tx * basis.ux + ty * basis.uy + tz * basis.uz;
  var cz = tx * basis.fx + ty * basis.fy + tz * basis.fz;
  if (cz < 0.18) return null;
  var f = (H * 0.62) / Math.tan(FOV * 0.5);
  return { x: W * 0.5 + cx * f / cz, y: H * 0.5 - cy * f / cz, z: cz };
}

function mouseRay(mx, my) {
  var f = (H * 0.62) / Math.tan(FOV * 0.5);
  var cx = (mx - W * 0.5) / f;
  var cy = (H * 0.5 - my) / f;
  var dx = basis.rx * cx + basis.ux * cy + basis.fx;
  var dy = basis.ry * cx + basis.uy * cy + basis.fy;
  var dz = basis.rz * cx + basis.uz * cy + basis.fz;
  var len = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1;
  dx /= len; dy /= len; dz /= len;
  if (Math.abs(dy) < 1e-5) return null;
  var t = (0.06 - cam.y) / dy;
  if (t < 0.1) return null;
  return { x: cam.x + dx * t, y: 0.06, z: cam.z + dz * t };
}

function pickSquare(mx, my) {
  var hit = mouseRay(mx, my);
  if (!hit) return null;
  var s = worldSq(hit.x, hit.z);
  if (s.f < 0 || s.r < 0 || s.f > 7 || s.r > 7) return null;
  return s;
}

var quads = [];
