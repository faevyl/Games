  piece.yaw = Math.atan2(w.x - piece.x, w.z - piece.z);
}

function fallPiece(p, dx, dz, hard) {
  if (!p) return;
  var len = Math.sqrt(dx * dx + dz * dz) || 1;
  fallen.push({
    p: p, x: p.x, z: p.z, y: 0.2, rot: 0,
    spin: (Math.random() - 0.5) * (hard ? 6 : 2.2),
    vx: (dx / len) * (hard ? 3.4 : 1.3),
    vz: (dz / len) * (hard ? 3.4 : 1.3),
    life: hard ? 1.05 : 0.7,
