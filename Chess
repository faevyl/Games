    if (lm) {
      if (lastMove.fx === 'brilliant') { cr = (cr + 40) / 2; cg = (cg + 210) / 2; cb = (cb + 220) / 2; }
      else if (lastMove.fx === 'great') { cr = (cr + 70) / 2; cg = (cg + 220) / 2; cb = (cb + 90) / 2; }
      else if (lastMove.fx === 'best') { cr = (cr + 240) / 2; cg = (cg + 190) / 2; cb = (cb + 50) / 2; }
      else if (lastMove.fx === 'kill') { cr = (cr + 220) / 2; cg = (cg + 70) / 2; cb = (cb + 50) / 2; }
      else { cr = (cr + 180) / 2; cg = (cg + 140) / 2; cb = (cb + 60) / 2; }
    }
    if (hintMove && aiElo >= 2200 && ((hintMove.f0 === f && hintMove.r0 === r) || (hintMove.f1 === f && hintMove.r1 === r))) {
      var dest = hintMove.f1 === f && hintMove.r1 === r;
      cr = (cr + (dest ? 255 : 236)) / 2;
      cg = (cg + (dest ? 198 : 168)) / 2;
      cb = (cb + 48) / 2;
    }
    if (hov) { cr = Math.min(255, cr + 40); cg = Math.min(255, cg + 35); }
    if (mark === 1) { cg = Math.min(255, cg + 70); cr = Math.max(40, cr - 20); }
    if (mark === 2) { cr = 200; cg = 70; cb = 50; }
    pushQuad(
      { x: w.x - SQ * 0.5, y: 0.05, z: w.z - SQ * 0.5 },
      { x: w.x + SQ * 0.5, y: 0.05, z: w.z - SQ * 0.5 },
      { x: w.x + SQ * 0.5, y: 0.05, z: w.z + SQ * 0.5 },
      { x: w.x - SQ * 0.5, y: 0.05, z: w.z + SQ * 0.5 },
      cr, cg, cb
    );
    if (mark === 1 && !board[r][f]) {
      pushBox(0, 0.1, 0, 0.22, 0.06, 0.22, 0, 0, w.x, 0, w.z, 80, 200, 110);
    }
  }
}

function addHintArrow() {
  if (!hintMove || aiElo < 2200 || !isPlayerTurn()) return;
  var a = sqWorld(hintMove.f0, hintMove.r0);
  var b = sqWorld(hintMove.f1, hintMove.r1);
  var dx = b.x - a.x, dz = b.z - a.z;
  var len = Math.sqrt(dx * dx + dz * dz) || 1;
  var yaw = Math.atan2(dx, dz);
  var pulse = 0.62 + Math.sin(time * 5.2) * 0.22;
  var gr = 255 * pulse, gg = 205 * pulse, gb = 70 * pulse;
  var mx = (a.x + b.x) * 0.5, mz = (a.z + b.z) * 0.5;
  var shaft = Math.max(0.18, len - 0.55);
  pushBox(0, 0.09, 0, 1.02, 0.035, 1.02, 0, 0, a.x, 0, a.z, gr * 0.7, gg * 0.7, gb * 0.7);
  pushBox(0, 0.09, 0, 1.02, 0.035, 1.02, 0, 0, b.x, 0, b.z, gr, gg, gb);
  pushBox(0, 0.14, 0, 0.11, 0.05, shaft, 0, yaw, mx, 0, mz, gr, gg, gb);
  pushBox(0, 0.16, 0, 0.32, 0.06, 0.22, 0, yaw, b.x - Math.sin(yaw) * 0.18, 0, b.z - Math.cos(yaw) * 0.18, 255, 220, 90);
  if (!board[hintMove.r1][hintMove.f1]) {
    pushBox(0, 0.12, 0, 0.28, 0.07, 0.28, 0, time * 2, b.x, 0, b.z, gr, gg, gb);
  }
}

function flushQuads(outline) {
  var i, a;
  quads.sort(function (a, b) { return b.z - a.z; });
  for (i = 0; i < quads.length; i++) {
    a = quads[i];
    ctx.globalAlpha = a.al;
    ctx.fillStyle = 'rgb(' + (a.r | 0) + ',' + (a.g | 0) + ',' + (a.bl | 0) + ')';
    ctx.beginPath();
    ctx.moveTo(a.a.x, a.a.y);
    ctx.lineTo(a.b.x, a.b.y);
    ctx.lineTo(a.c.x, a.c.y);
    ctx.lineTo(a.d.x, a.d.y);
    ctx.closePath();
    ctx.fill();
    if (outline) {
      ctx.strokeStyle = 'rgba(8,10,14,0.45)';
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }
  }
  ctx.globalAlpha = 1;
  quads.length = 0;
}

function pieceDepth(p) {
  var tx = p.x - cam.x, ty = p.y + 0.55 - cam.y, tz = p.z - cam.z;
  return tx * basis.fx + ty * basis.fy + tz * basis.fz;
}

function draw() {
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  var g = ctx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#1a242e');
  g.addColorStop(1, '#0b0e12');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, W, H);

  quads.length = 0;
  addTable();
  flushQuads(false);
  addBoard();
  addHintArrow();
  flushQuads(false);

  var r, f, p, i, a, list = [];
  for (r = 0; r < 8; r++) for (f = 0; f < 8; f++) {
    p = board[r][f];
    if (p) {
      p.squash += (1 - p.squash) * 0.12;
      list.push(p);
    }
  }
  list.sort(function (a, b) { return pieceDepth(b) - pieceDepth(a); });
  for (i = 0; i < list.length; i++) {
    addPiece(list[i], 0, 0);
    flushQuads(true);
  }
  for (i = 0; i < fallen.length; i++) {
    a = fallen[i];
    a.p.x = a.x; a.p.z = a.z; a.p.y = a.y; a.p.yaw = a.yaw;
    addPiece(a.p, 0, a.rot);
    flushQuads(true);
  }
  if (sparks.length) {
    addSparks();
    flushQuads(false);
  }

  var files = 'ABCDEFGH';
  var w, sp;
  ctx.font = '13px Georgia';
  ctx.fillStyle = 'rgba(200,180,140,0.55)';
  ctx.textAlign = 'center';
  for (f = 0; f < 8; f++) {
    w = sqWorld(f, -0.72);
    sp = project(w.x, 0.05, w.z);
    if (sp) ctx.fillText(files[f], sp.x, sp.y);
    w = sqWorld(-0.72, f);
    sp = project(w.x, 0.05, w.z);
    if (sp) ctx.fillText(String(f + 1), sp.x, sp.y);
  }
  if (screenFx) {
    var tint = fxColor(screenFx.kind);
    var ta = Math.sin(Math.min(1, screenFx.t / 0.12) * Math.PI) * 0.16 * (1 - screenFx.t / screenFx.dur);
    ctx.fillStyle = 'rgba(' + tint[0] + ',' + tint[1] + ',' + tint[2] + ',' + ta + ')';
    ctx.fillRect(0, 0, W, H);
  }
}

function canvasPos(e) {
  var rect = canvas.getBoundingClientRect();
  return {
    x: (e.clientX - rect.left) * (canvas.width / rect.width),
    y: (e.clientY - rect.top) * (canvas.height / rect.height)
  };
}

function tryClick(mx, my) {
  if (!started) {
    started = true;
    ui.style.display = 'none';
    if (audioCtx && audioCtx.resume) audioCtx.resume();
  }
  if (busy() && over) {
    setupBoard();
    return;
  }
  if (busy()) return;
  if (vsAI && turn === aiColor) return;
  var s = pickSquare(mx, my);
  if (!s) { selected = null; legal = []; return; }
  var i, m, p = pieceAt(s.f, s.r);
  if (selected) {
    for (i = 0; i < legal.length; i++) {
      m = legal[i];
      if (m.f1 === s.f && m.r1 === s.r) {
        playMove(m);
        return;
      }
    }
  }
  if (p && p.c === turn) {
    selected = p;
    legal = allLegal().filter(function (mv) { return mv.f0 === p.f && mv.r0 === p.r; });
    wantFocus.x = p.x * 0.25;
    wantFocus.z = p.z * 0.25;
    beep(520, 0.04);
  } else {
    selected = null;
    legal = [];
  }
}

function refreshHud() {
  if (over === 'mate') {
    turnEl.textContent = (turn === 0 ? 'BLACK' : 'WHITE') + ' WINS';
    hud.textContent = 'checkmate  ·  click the board for a new game';
  } else if (over === 'stale') {
    turnEl.textContent = 'DRAW';
    hud.textContent = 'stalemate  ·  click for a new game';
  } else {
    turnEl.innerHTML = (turn === 0 ? 'WHITE' : 'BLACK') + ' TO MOVE' + (inCheck(board, turn) ? ' <b>· CHECK</b>' : '');
    hud.textContent = vsAI && turn === aiColor
      ? ((engineMode === 'gambit' ? (lastGambit || 'gambit') : 'house') + ' ' + aiElo + ' is thinking')
      : (hintMove && aiElo >= 2200
        ? ('best  ' + formatHint(hintMove) + '  ·  gold arrow')
        : 'left click a piece  ·  right drag to orbit');
  }
  refreshSide();
}

canvas.addEventListener('mousedown', function (e) {
  var p = canvasPos(e);
  if (e.button === 2 || e.button === 1) {
    dragging = true;
    canvas.className = 'drag';
    lastMX = e.clientX; lastMY = e.clientY;
    e.preventDefault();
    return;
  }
  if (e.button === 0) {
    canvas.focus();
    tryClick(p.x, p.y);
  }
});
window.addEventListener('mouseup', function () {
  dragging = false;
  canvas.className = '';
});
window.addEventListener('mousemove', function (e) {
  if (dragging) {
    orbit.yaw -= (e.clientX - lastMX) * 0.006;
    orbit.pitch += (e.clientY - lastMY) * 0.0045;
    if (orbit.pitch < 0.28) orbit.pitch = 0.28;
    if (orbit.pitch > 1.25) orbit.pitch = 1.25;
    lastMX = e.clientX; lastMY = e.clientY;
    return;
  }
  var p = canvasPos(e);
  hover = pickSquare(p.x, p.y);
});
canvas.addEventListener('wheel', function (e) {
  e.preventDefault();
  orbit.dist += e.deltaY * 0.01;
  if (orbit.dist < 7) orbit.dist = 7;
  if (orbit.dist > 20) orbit.dist = 20;
}, { passive: false });
canvas.addEventListener('contextmenu', function (e) { e.preventDefault(); });

document.addEventListener('keydown', function (e) {
  keys[e.code] = true;
  if (e.code === 'KeyR') setupBoard();
  if (e.code === 'KeyT') {
    vsAI = !vsAI;
    refreshSide();
  }
  if (e.code === 'BracketLeft' || e.code === 'Minus') setElo(aiElo - 50);
  if (e.code === 'BracketRight' || e.code === 'Equal') setElo(aiElo + 50);
});
document.addEventListener('keyup', function (e) { keys[e.code] = false; });

eloSlider.addEventListener('input', function () { setElo(Number(eloSlider.value)); });
eloPresets.addEventListener('click', function (e) {
  var b = e.target.getAttribute && e.target.getAttribute('data-elo');
  if (b) setElo(Number(b));
});
aiTog.addEventListener('click', function () {
  vsAI = !vsAI;
  refreshSide();
});
document.getElementById('engines').addEventListener('click', function (e) {
  var m = e.target.getAttribute && e.target.getAttribute('data-eng');
  if (!m) return;
  engineMode = m;
  if (m === 'gambit') aiColor = 0;
  setupBoard();
  refreshSide();
});
document.getElementById('colors').addEventListener('click', function (e) {
  var c = e.target.getAttribute && e.target.getAttribute('data-color');
  if (c == null) return;
  aiColor = Number(c);
  setupBoard();
  refreshSide();
});
document.getElementById('elo').addEventListener('mousedown', function (e) { e.stopPropagation(); });

setupBoard();
setElo(1200);
var last = performance.now();
var aiWait = 0;

function tick(now) {
  var dt = (now - last) / 1000;
  last = now;
  if (dt > 0.05) dt = 0.05;
  time += dt;
  if (checkPulse > 0) checkPulse -= dt;
  if (keys.KeyA || keys.ArrowLeft) orbit.yaw -= 1.2 * dt;
  if (keys.KeyD || keys.ArrowRight) orbit.yaw += 1.2 * dt;
  if (keys.KeyW || keys.ArrowUp) orbit.pitch = Math.max(0.28, orbit.pitch - 0.7 * dt);
  if (keys.KeyS || keys.ArrowDown) orbit.pitch = Math.min(1.25, orbit.pitch + 0.7 * dt);

  updateAnims(dt);
  if (anims.length === 0 && !over) {
    wantFocus.x += (0 - wantFocus.x) * dt * 0.7;
    wantFocus.z += (0 - wantFocus.z) * dt * 0.7;
  }
  refreshHint();
  if (vsAI && turn === aiColor && anims.length === 0 && !over && started) {
    aiWait += dt;
    if (aiWait > aiProfile().think) {
      aiWait = 0;
      requestAiMove();
    }
  } else aiWait = 0;

  updateCam(dt);
  draw();
  refreshHud();
  requestAnimationFrame(tick);
}

requestAnimationFrame(tick);
</script>
