function playMove(m, givenKind) {
  var p = board[m.r0][m.f0];
  var cap = board[m.r1][m.f1];
  var rook, w, kind;
  if (!p) return;
  if (m.ep) cap = board[m.r0][m.f1];
  kind = givenKind;
  if (kind === undefined) kind = ratePlayedMove(m) || '';
  if (cap && !kind) kind = 'kill';
  uciMoves.push(moveToUci(m));
  if (cap) {
    fallPiece(cap, m.f1 - m.f0, m.r1 - m.r0, !!kind);
    beep(kind === 'kill' || kind === 'brilliant' ? 150 : 180, 0.14, 'triangle');
  } else {
    beep(kind === 'brilliant' ? 760 : kind === 'great' ? 640 : kind === 'best' ? 540 : 420, 0.07, 'sine');
  }
  if (kind) {
    startScreenFx(kind);
    beep(kind === 'brilliant' ? 920 : kind === 'great' ? 780 : kind === 'best' ? 660 : 240, 0.12, kind === 'kill' ? 'sawtooth' : 'square');
  }
  if (cap && kind && kind !== 'kill') spawnSparks(cap.x, 0.4, cap.z, 10, fxColor('kill'), 1.9);
  startAnim(p, m.f1, m.r1, p.t === 'n' ? 'hop' : 'walk', 0, kind);
  if (m.castle === 'k') {
    rook = board[m.r0][7];
    if (rook) startAnim(rook, 5, m.r0, 'castle', 0.08, '');
  }
  if (m.castle === 'q') {
    rook = board[m.r0][0];
    if (rook) startAnim(rook, 3, m.r0, 'castle', 0.08, '');
  }
  applyOn(board, castle, ep, m);
  castle = { 0: { k: castle[0].k, q: castle[0].q }, 1: { k: castle[1].k, q: castle[1].q } };
  if (p.t === 'k') { castle[p.c].k = 0; castle[p.c].q = 0; }
  if (p.t === 'r') {
    if (m.f0 === 0) castle[p.c].q = 0;
    if (m.f0 === 7) castle[p.c].k = 0;
  }
  if (cap && cap.t === 'r') {
    if (m.f1 === 0) castle[cap.c].q = 0;
    if (m.f1 === 7) castle[cap.c].k = 0;
  }
  ep = m.dpush ? { f: m.f0, r: (m.r0 + m.r1) / 2 } : null;
  lastMove = m;
  lastMove.fx = kind;
  w = sqWorld(m.f1, m.r1);
  wantFocus.x = w.x * 0.45;
  wantFocus.z = w.z * 0.45;
  selected = null;
  legal = [];
  turn = 1 - turn;
  if (inCheck(board, turn)) {
    checkPulse = 1;
    beep(140, 0.18, 'square');
  }
  var replies = allLegal();
  if (!replies.length) {
    over = inCheck(board, turn) ? 'mate' : 'stale';
    beep(over === 'mate' ? 90 : 300, 0.35, 'sine');
  }
}

function busy() {
  return anims.length > 0 || over;
}

function updateAnims(dt) {
  var i, a, u, pose, face, col;
  for (i = anims.length - 1; i >= 0; i--) {
    a = anims[i];
    a.t += dt;
    if (a.t < 0) continue;
    u = a.t / a.dur;
    if (u > 1) u = 1;
    pose = poseFromAnim(a, u);
    a.p.x = a.x0 + (a.x1 - a.x0) * pose.k;
    a.p.z = a.z0 + (a.z1 - a.z0) * pose.k;
    a.p.y = pose.lift;
    a.p.walk += dt * 18;
    face = Math.atan2(a.x1 - a.x0, a.z1 - a.z0);
    a.p.yaw = face + pose.yawWob;
    a.p.lean = pose.lean;
    a.p.spin = pose.spin;
    a.p.squash = pose.squash;
    if (a.fx && !a.burst && u >= 0.72) {
      a.burst = 1;
      col = fxColor(a.fx);
      spawnSparks(a.x1, 0.4, a.z1, a.fx === 'brilliant' ? 18 : a.fx === 'kill' ? 16 : 12, col, a.fx === 'kill' ? 2.2 : 1.5);
    }
    if (u >= 1) {
      a.p.x = a.x1; a.p.z = a.z1; a.p.y = 0; a.p.squash = 0.82;
      a.p.yaw = a.p.c === 0 ? 0 : Math.PI;
      a.p.lean = 0; a.p.spin = 0;
      anims.splice(i, 1);
    }
