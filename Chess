  var cy = Math.cos(orbit.yaw), sy = Math.sin(orbit.yaw);
  var tx = focus.x + sy * cp * orbit.dist;
  var ty = focus.y + sp * orbit.dist;
  var tz = focus.z + cy * cp * orbit.dist;
  cam.x += (tx - cam.x) * k;
  cam.y += (ty - cam.y) * k;
  cam.z += (tz - cam.z) * k;
  look.x += (focus.x - look.x) * k;
  look.y += (focus.y - look.y) * k;
  look.z += (focus.z - look.z) * k;
