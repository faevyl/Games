    --bg: #0c1014; --fg: #e8dcc8; --bar: #14181e; --line: #3a3226; --title: #f0e0c0;
    --btn: #1a1814; --btn-fg: #c8b490; --accent: #c8a060; --muted: #7a6a52;
    --side: #101418; --card: #171410; --card-line: #2a241c; --hover: #d8c4a0;
  }
  [data-theme="void"] {
    --bg: #08060e; --fg: #ddd0f0; --bar: #120e1a; --line: #3a2a52; --title: #efe6ff;
    --btn: #16101f; --btn-fg: #b8a0d8; --accent: #9a70e0; --muted: #7a6a92;
    --side: #0c0a14; --card: #14101c; --card-line: #2a2038; --hover: #d0c0ec;
  }
  [data-theme="arcade"] {
    --bg: #12080a; --fg: #f0d4c8; --bar: #1c1012; --line: #5a2830; --title: #ffe8dc;
    --btn: #221014; --btn-fg: #e09080; --accent: #e05040; --muted: #8a6058;
    --side: #140c0e; --card: #1c1012; --card-line: #3a2024; --hover: #f0c4b8;
  }
  [data-theme="moss"] {
    --bg: #0c1410; --fg: #d4e4cc; --bar: #101814; --line: #2a4a32; --title: #e8f4dc;
    --btn: #121a14; --btn-fg: #90b888; --accent: #6aaa60; --muted: #62805a;
    --side: #0c1410; --card: #121a14; --card-line: #243828; --hover: #c8dcb8;
  }
  [data-theme="ice"] {
    --bg: #0a1018; --fg: #d0dce8; --bar: #101820; --line: #2a4058; --title: #e8f0f8;
    --btn: #121820; --btn-fg: #90b0c8; --accent: #68a0d0; --muted: #6a8098;
    --side: #0c1218; --card: #121820; --card-line: #243040; --hover: #c8d8e8;
  }
  [data-theme="paper"] {
    --bg: #e8dcc8; --fg: #2a241c; --bar: #f0e6d4; --line: #c8b490; --title: #1a1410;
    --btn: #f4ead8; --btn-fg: #5a4030; --accent: #8a5030; --muted: #7a6a52;
    --side: #efe4d2; --card: #f6ecda; --card-line: #d8c4a0; --hover: #3a3020;
  }
  [data-theme="lab"] {
    --bg: #0b1014; --fg: #c8d8c0; --bar: #10161c; --line: #2a3a32; --title: #d8f0cc;
    --btn: #141c18; --btn-fg: #8ec8a0; --accent: #5ad08a; --muted: #6a8070;
    --side: #0c1210; --card: #121a16; --card-line: #24342c; --hover: #c8e8d0;
  }
  html, body { margin: 0; width: 100%; height: 100%; min-height: 100%; background: var(--bg); color: var(--fg); font-family: Georgia, serif; }
  body { display: flex; flex-direction: column; overflow: hidden; }
  #bar {
    flex: 0 0 auto; display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    padding: 10px 12px; background: var(--bar); border-bottom: 1px solid var(--line);
  }
  #bar h1 { margin: 0 8px 0 0; font-size: 13px; font-weight: 400; letter-spacing: 1px; color: var(--title); }
  #bar input {
    flex: 1 1 160px; min-width: 120px; background: var(--btn); color: var(--title);
    border: 1px solid var(--line); padding: 6px 8px; font: 13px Georgia, serif;
  }
  #bar button, #tabs button, #themes button {
    background: var(--btn); color: var(--btn-fg); border: 1px solid var(--line);
    font: 12px Georgia, serif; padding: 6px 10px; cursor: pointer;
  }
  #bar button.on, #tabs button.on, #themes button.on { background: var(--card); color: var(--title); border-color: var(--accent); }
  #stat { font-size: 11px; color: var(--muted); white-space: nowrap; }
  #main { flex: 1 1 auto; display: flex; min-height: 240px; height: 100%; }
  #side {
    width: 280px; max-width: 42%; overflow: auto; background: var(--side);
    border-right: 1px solid var(--line); flex: 0 0 auto;
  }
  #tools { position: sticky; top: 0; z-index: 1; background: var(--side); padding: 8px 8px 4px; }
  #tabs { display: flex; gap: 4px; margin-bottom: 8px; }
  #q {
    display: block; width: 100%; box-sizing: border-box; background: var(--btn); color: var(--title);
    border: 1px solid var(--line); padding: 8px 10px; font: 13px Georgia, serif;
  }
  #list { padding: 0 8px 12px; }
  .g {
    display: block; width: 100%; text-align: left; margin: 0 0 4px;
    background: var(--card); color: var(--hover); border: 1px solid var(--card-line);
    font: 13px Georgia, serif; padding: 8px 10px; cursor: pointer;
  }
  .g:hover, .g.sel { border-color: var(--accent); color: var(--title); }
  .g b { display: block; font-weight: 400; color: var(--title); }
  .g i { font-style: normal; font-size: 11px; color: var(--muted); }
  #play { flex: 1 1 auto; position: relative; background: #000; min-width: 280px; min-height: 240px; }
  #play iframe {
    position: absolute; inset: 0; width: 100%; height: 100%; min-width: 280px; min-height: 240px;
    border: 0; background: #000; display: block;
  }
  body.playing #play { min-width: 320px; }
  #codeWrap {
    display: none; position: absolute; inset: 0; flex-direction: column;
    background: #0a0e10; min-width: 280px; min-height: 240px; z-index: 2;
  }
  body.view-raw #codeWrap { display: flex; }
  body.view-raw #frame { visibility: hidden; }
  #codeMeta, #codeBar {
    flex: 0 0 auto; padding: 6px 10px; font: 11px Consolas, "Cascadia Mono", monospace;
    color: var(--muted); border-bottom: 1px solid var(--line);
    background: var(--bar); word-break: break-all;
  }
  #codeBar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  #codeBar button { font: 11px Consolas, monospace; padding: 4px 8px; }
  #codeBar span { margin-left: auto; font-size: 10px; color: var(--muted); }
  #codeEdit { flex: 1 1 auto; position: relative; min-height: 0; }
  #codeHi, #code {
    position: absolute; inset: 0; width: 100%; height: 100%; box-sizing: border-box;
    margin: 0; border: 0; padding: 10px 12px; resize: none; outline: none;
    font: 12px/1.45 Consolas, "Cascadia Mono", monospace; tab-size: 2;
    white-space: pre; overflow: auto; word-wrap: normal;
  }
  #codeHi {
    pointer-events: none; z-index: 0; color: #8fa08a;
    background: #0a0e10;
  }
  #codeHi { color: #8fa08a; }
  #codeHi .tag { color: #7ec8e8; }
  #codeHi .attr { color: #d4c07a; }
  #codeHi .str { color: #c9a0e8; }
  #codeHi .cmt { color: #5a7060; font-style: italic; }
  #codeHi .key { color: #e09070; }
  #codeHi .num { color: #80d0a8; }
  #codeHi .sel { color: #b8d080; }
  #code {
    z-index: 1; background: transparent; color: transparent; caret-color: #d4e8cc;
  }
  #suggest {
    display: none; position: absolute; z-index: 14; max-height: 240px; overflow: auto;
    min-width: 240px; max-width: min(420px, 90%); background: var(--card);
    border: 1px solid var(--accent); box-shadow: 0 8px 24px rgba(0,0,0,0.45);
  }
  #suggest.on { display: block; }
  #suggest button {
    display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid var(--card-line);
    background: transparent; color: var(--title); font: 12px Consolas, monospace;
    padding: 6px 10px; cursor: pointer;
  }
  #suggest button:last-child { border-bottom: 0; }
  #suggest button.on, #suggest button:hover { background: var(--btn); color: var(--accent); }
  #suggest button i { font-style: normal; float: right; color: var(--muted); font-size: 10px; letter-spacing: 1px; }
  #empty {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--muted); text-align: center; padding: 24px; pointer-events: none;
  }
  #empty.hide { display: none; }
  #load {
    position: absolute; inset: 0; z-index: 8; display: none;
    flex-direction: column; align-items: center; justify-content: center;
    background: var(--bg); color: var(--title); text-align: center; padding: 24px;
  }
  #load.on { display: flex; }
  #spin {
    width: 26px; height: 26px; margin-bottom: 14px;
    border: 2px solid var(--line); border-top-color: var(--accent);
    border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  #load b { display: block; font-weight: 400; letter-spacing: 3px; font-size: 13px; color: var(--accent); margin-bottom: 8px; }
  #load p { margin: 0; color: var(--muted); font: 13px Georgia, serif; }
  #note {
    position: fixed; right: 16px; bottom: 16px; z-index: 50; display: none;
    width: 320px; max-width: calc(100% - 24px); padding: 12px 32px 12px 14px;
    background: var(--card); color: var(--title); border: 1px solid var(--accent);
    font: 13px/1.4 Georgia, serif;
  }
  #note.on { display: block; }
  #note b { display: block; font-weight: 400; letter-spacing: 1px; color: var(--btn-fg); font-size: 11px; margin-bottom: 4px; }
  #note p { margin: 0; color: var(--title); }
  #note .x, #sheetX {
    position: absolute; top: 6px; right: 8px; border: 0; background: transparent;
    color: var(--muted); font: 16px Georgia, serif; cursor: pointer; padding: 2px 6px;
  }
  #sheet {
    display: none; position: fixed; inset: 0; z-index: 40; background: rgba(0,0,0,0.55);
    align-items: center; justify-content: center; padding: 16px;
  }
  #sheet.on { display: flex; }
  #sheetBox {
    position: relative; width: 420px; max-width: 100%; max-height: min(70vh, 520px);
    overflow: auto; background: var(--bar); color: var(--fg); border: 1px solid var(--accent);
    padding: 16px 16px 12px;
  }
  #sheetBox h2 { margin: 0 28px 12px 0; font-size: 13px; font-weight: 400; letter-spacing: 2px; color: var(--accent); }
  .log { margin: 0 0 12px; padding: 0 0 10px; border-bottom: 1px solid var(--line); }
  .log:last-child { border-bottom: 0; margin-bottom: 0; }
  .log b { display: block; font-weight: 400; font-size: 11px; letter-spacing: 1px; color: var(--btn-fg); margin-bottom: 4px; }
  .log p { margin: 0; font: 13px/1.45 Georgia, serif; color: var(--fg); }
  #themes { display: flex; flex-wrap: wrap; gap: 6px; }
  body.max #side, body.playing.tight #side { display: none; }
  #play:fullscreen, #play:-webkit-full-screen,
  html:fullscreen, html:-webkit-full-screen { width: 100%; height: 100%; background: #000; }
</style>
</head>
<body>
<div id="bar">
  <h1>GAME HTML DEV SUITE</h1>
  <button type="button" id="back">LIST</button>
  <button type="button" id="modeRaw">RAW</button>
  <button type="button" id="modePlay" class="on">PLAY</button>
  <button type="button" id="runBtn">RUN</button>
  <button type="button" id="copyBtn">COPY</button>
  <button type="button" id="full">FULL</button>
  <button type="button" id="logBtn">HELP</button>
  <button type="button" id="themeBtn">THEME</button>
  <span id="stat">loading…</span>
</div>
<div id="main">
  <div id="side">
    <div id="tools">
      <div id="tabs">
        <button type="button" class="on" data-tab="all">ALL</button>
        <button type="button" data-tab="flash">RUFFLE</button>
        <button type="button" data-tab="nds">DS</button>
        <button type="button" data-tab="web">HTML</button>
      </div>
      <input id="q" type="search" placeholder="Search games" autocomplete="off">
      <input id="srcUrl" type="url" placeholder="Or paste a game html url" autocomplete="off" style="display:block;width:100%;box-sizing:border-box;margin-top:6px;background:var(--btn);color:var(--title);border:1px solid var(--line);padding:8px 10px;font:12px Consolas,monospace">
      <button type="button" id="fetchBtn" style="width:100%;margin-top:6px">FETCH URL</button>
    </div>
    <div id="list"></div>
  </div>
  <div id="play">
    <div id="empty">Pick a game. RAW edits the html with suggestions (Ctrl+Space). PLAY runs it. RUN plays the editor.</div>
    <div id="codeWrap">
      <div id="codeMeta">no source loaded</div>
      <div id="codeBar">
        <button type="button" class="on" data-lang="auto">AUTO</button>
        <button type="button" data-lang="html">HTML</button>
        <button type="button" data-lang="css">CSS</button>
        <button type="button" data-lang="javascript">JS</button>
        <span>Ctrl+Space · Tab to accept</span>
      </div>
      <div id="codeEdit">
        <pre id="codeHi" aria-hidden="true"></pre>
        <textarea id="code" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="Game html shows up here. Type for suggestions, then RUN."></textarea>
        <div id="suggest"></div>
      </div>
    </div>
    <iframe id="frame" title="game" allow="autoplay; fullscreen; gamepad; clipboard-write; xr-spatial-tracking" allowfullscreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
    <div id="load" class="on">
      <div id="spin"></div>
      <b>GAME HTML DEV SUITE</b>
      <p id="loadMsg">loading games…</p>
    </div>
  </div>
</div>
<div id="note">
  <b>Game Html Dev Suite</b>
  <p id="noteMsg">yk i cant load roblox, sorry...</p>
  <button type="button" class="x" id="noteX" aria-label="close">×</button>
</div>
<div id="sheet">
  <div id="sheetBox">
    <button type="button" id="sheetX" aria-label="close">×</button>
    <h2 id="sheetTitle">HELP</h2>
    <div id="logPane"></div>
    <div id="themePane" style="display:none">
      <div id="themes"></div>
    </div>
  </div>
</div>
