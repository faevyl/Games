  function cssValueMode(text, pos) {
    var bit = text.slice(Math.max(0, pos - 80), pos);
    var col = bit.lastIndexOf(":");
    var stop = Math.max(bit.lastIndexOf(";"), bit.lastIndexOf("{"));
    return col > stop;
  }

  function listHints(kind, text, pos) {
    var rows = [];
    if (kind === "html") rows = HINTS.html;
    else if (kind === "html-tag") rows = inTag(text, pos) && /<[\w:-]*$/.test(text.slice(0, pos)) ? HINTS.html : HINTS.attrs;
    else if (kind === "css") rows = cssValueMode(text, pos) ? HINTS.cssval : HINTS.css;
    else rows = HINTS.js;
    var pre = wordAt(text, pos).replace(/^[@.#]/, "").toLowerCase();
    var lt = text.charAt(pos - pre.length - (text.charAt(pos - pre.length - 1) === "<" ? 1 : 0));
    var out = [];
    var i, row, lab;
    for (i = 0; i < rows.length; i++) {
      row = rows[i];
      lab = row[0].toLowerCase();
      if (!pre || lab.indexOf(pre) === 0 || lab.indexOf(pre) !== -1) out.push(row);
    }
    if (kind === "html" && (pre === "<" || lt === "<")) {
      out = HINTS.html.filter(function (r) { return !pre || r[0].toLowerCase().indexOf(pre.replace("<", "")) === 0; });
    }
    return out.slice(0, 24);
  }

  function hideSuggest() {
