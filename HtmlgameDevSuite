<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Game Html Dev Suite</title>
<!--
  One file. Same game list as Why Revived.
  RAW = the html source. PLAY = run the game. RUN = play whatever is in the editor.
-->
<style>
