    if (open && (e.key === "ArrowDown" || e.key === "ArrowUp")) {
      e.preventDefault();
      suggestI = (suggestI + (e.key === "ArrowDown" ? 1 : suggestItems.length - 1)) % suggestItems.length;
      [].forEach.call(box.querySelectorAll("button"), function (b, n) {
        b.className = n === suggestI ? "on" : "";
