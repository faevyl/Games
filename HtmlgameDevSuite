  function caretBox(el) {
    var probe = document.getElementById("caretProbe");
    if (!probe) {
      probe = document.createElement("div");
      probe.id = "caretProbe";
      probe.setAttribute("aria-hidden", "true");
      document.body.appendChild(probe);
    }
    var cs = window.getComputedStyle(el);
    probe.style.cssText = "position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre;font:" + cs.font +
      ";padding:" + cs.padding + ";border:" + cs.border + ";width:" + el.clientWidth + "px;line-height:" + cs.lineHeight + ";";
    var v = el.value.slice(0, el.selectionStart);
    probe.textContent = v;
    var mark = document.createElement("span");
    mark.textContent = "|";
    probe.appendChild(mark);
    var r = el.getBoundingClientRect();
    var pr = probe.getBoundingClientRect();
    var mr = mark.getBoundingClientRect();
    return { x: r.left + (mr.left - pr.left) - el.scrollLeft, y: r.top + (mr.top - pr.top) - el.scrollTop };
  }

  function showSuggest(items) {
    var box = document.getElementById("suggest");
    var el = document.getElementById("code");
    suggestItems = items || [];
    suggestI = 0;
    if (!suggestItems.length) { hideSuggest(); return; }
    box.innerHTML = suggestItems.map(function (row, i) {
      return '<button type="button" data-i="' + i + '" class="' + (i === 0 ? "on" : "") + '"><b>' +
        row[0].replace(/</g, "") + "</b><i>" + row[2] + "</i></button>";
    }).join("");
    var xy = caretBox(el);
    var wrap = document.getElementById("codeEdit").getBoundingClientRect();
    var x = Math.max(8, Math.min(xy.x - wrap.left, wrap.width - 260));
    var y = xy.y - wrap.top + 18;
    if (y + 180 > wrap.height) y = Math.max(8, xy.y - wrap.top - 160);
    box.style.left = x + "px";
    box.style.top = y + "px";
    box.className = "on";
  }

  function acceptSuggest(i) {
    var row = suggestItems[i];
    var el = document.getElementById("code");
    if (!row || !el) return;
    var pos = el.selectionStart;
    var text = el.value;
    var pre = wordAt(text, pos);
    var from = pos - pre.length;
    if (text.charAt(from - 1) === "<" && row[1].charAt(0) === "<") from -= 1;
    var ins = row[1];
    var caret = ins.indexOf("|");
    if (caret < 0) caret = ins.length;
    else ins = ins.replace("|", "");
    el.value = text.slice(0, from) + ins + text.slice(pos);
    el.selectionStart = el.selectionEnd = from + caret;
    hideSuggest();
    paintCode();
    el.focus();
  }

  function updateSuggest(force) {
    var el = document.getElementById("code");
    if (!el) return;
    var pos = el.selectionStart;
    var text = el.value;
    var kind = codeKind(text, pos);
    var pre = wordAt(text, pos);
    if (!force && pre.length < 1) { hideSuggest(); return; }
    showSuggest(listHints(kind, text, pos));
