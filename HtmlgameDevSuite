    if (open && (e.key === "Enter" || e.key === "Tab") && !e.shiftKey) {
      e.preventDefault();
      acceptSuggest(suggestI);
      return;
    }
    if (open && e.key === "Escape") {
      e.preventDefault();
      hideSuggest();
      return;
