re-status-text\">waiting</span>\n      </div>\n\n      <div class=\"bar-sep\"></div>\n\n      <button class=\"icon-btn\" id=\"load-core\" data-tip=\"Load Core\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M8 2v8M5 8l3 3 3-3M2 13h12\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n      <label class=\"icon-btn\" data-tip=\"Select ROM\" style=\"cursor: pointer\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <rect\n            x=\"2\"\n            y=\"2\"\n            width=\"12\"\n            height=\"12\"\n            rx=\"2.5\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n          />\n          <path\n            d=\"M6 8h4M8 6v4\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n        <input\n          id=\"rom-input\"\n          type=\"file\"\n          accept=\".3ds,.cci,.cxi,.app,.bin,.zip\"\n        />\n      </label>\n\n      <label\n        class=\"icon-btn\"\n        data-tip=\"Homebrew (.3dsx)\"\n        style=\"cursor: pointer\"\n      >\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M8 2L2 6v8h12V6L8 2z\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linejoin=\"round\"\n          />\n          <path\n            d=\"M6 14v-4h4v4\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n        <input\n          id=\"sd-import-files\"\n          type=\"file\"\n          accept=\".3dsx,.z3dsx,.elf,.axf\"\n          multiple\n        />\n      </label>\n\n      <input id=\"sd-import-folder\" type=\"file\" webkitdirectory hidden />\n      <div id=\"sd-status-text\" hidden></div>\n\n      <button class=\"icon-btn\" id=\"boot-game\" data-tip=\"Boot\" disabled>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path d=\"M4.5 3l8 5-8 5V3z\" fill=\"currentColor\" />\n        </svg>\n      </button>\n\n      <div class=\"bar-sep\"></div>\n\n      <button\n        class=\"icon-btn\"\n        id=\"save-state-btn\"\n        data-tip=\"Save State\"\n        disabled\n      >\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M2 2h9l3 3v9H2V2z\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linejoin=\"round\"\n          />\n          <rect\n            x=\"5\"\n            y=\"2\"\n            width=\"4\"\n            height=\"3.5\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.2\"\n          />\n          <rect\n            x=\"3.5\"\n            y=\"8\"\n            width=\"9\"\n            height=\"4.5\"\n            rx=\"1\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.2\"\n          />\n        </svg>\n      </button>\n\n      <button class=\"icon-btn\" id=\"reset-core\" data-tip=\"Reset\" disabled>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M3 8a5 5 0 108-4.58\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n          />\n          <path\n            d=\"M11 3.5L8.5 1M11 3.5L8.5 6\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n      <button class=\"icon-btn\" id=\"stop-core\" data-tip=\"Stop\" disabled>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <rect\n            x=\"3.5\"\n            y=\"3.5\"\n            width=\"9\"\n            height=\"9\"\n            rx=\"1.5\"\n            fill=\"currentColor\"\n          />\n        </svg>\n      </button>\n\n      <button class=\"icon-btn\" id=\"unload-game\" data-tip=\"Unload Game\" disabled>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M8 14V6M5 9l3-3 3 3M2 13h12\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n      <button class=\"icon-btn\" id=\"controls-btn\" data-tip=\"Controls\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <rect\n            x=\"1.5\"\n            y=\"4\"\n            width=\"13\"\n            height=\"8\"\n            rx=\"2\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n          />\n          <path\n            d=\"M5 8h2M6 7v2M10.5 8h.01M12 8h.01\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n      </button>\n\n      <div class=\"bar-spacer\"></div>\n\n      <span class=\"fps-label\" id=\"meta-fps\"></span>\n\n      <div class=\"bar-sep\"></div>\n\n      <button class=\"icon-btn\" id=\"fullscreen-btn\" data-tip=\"Fullscreen\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n          <path\n            d=\"M1.5 1.5H5M1.5 1.5V5M14.5 1.5H11M14.5 1.5V5M1.5 14.5H5M1.5 14.5V11M14.5 14.5H11M14.5 14.5V11\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n      </button>\n    </div>\n\n    <div id=\"drop-overlay\">\n      <div id=\"drop-inner\">\n        <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" fill=\"none\">\n          <path\n            d=\"M20 6v20M12 18l8 8 8-8M6 32h28\"\n            stroke=\"#fff\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n        drop save state to load\n      </div>\n    </div>\n\n    <input id=\"import-state\" type=\"file\" accept=\".state,.bin\" />\n    <button id=\"export-state\" hidden></button>\n    <pre id=\"log\" hidden></pre>\n    <div id=\"slot-grid\" hidden></div>\n    <div id=\"rom-name\" hidden><span></span></div>\n    <div id=\"meta-library\" hidden></div>\n    <div id=\"meta-rom\" hidden></div>\n    <div id=\"meta-state-size\" hidden></div>\n    <div id=\"meta-frame\" hidden></div>\n    <div id=\"core-status\" class=\"status\" hidden></div>\n\n    <script>\n      const DEFAULT_KEYMAP = [\n        { action: \"A\", code: \"KeyZ\" },\n        { action: \"B\", code: \"KeyA\" },\n        { action: \"X\", code: \"KeyS\" },\n        { action: \"Y\", code: \"KeyQ\" },\n        { action: \"L\", code: \"KeyW\" },\n        { action: \"R\", code: \"ShiftRight\" },\n        { action: \"Start\", code: \"Enter\" },\n        { action: \"Up\", code: \"ArrowUp\" },\n        { action: \"Down\", code: \"ArrowDown\" },\n        { action: \"Left\", code: \"ArrowLeft\" },\n        { action: \"Right\", code: \"ArrowRight\" },\n      ];\n\n      const saved = JSON.parse(localStorage.getItem(\"azahar-keymap\") || \"null\");\n      const currentMap = saved || DEFAULT_KEYMAP.map((e) => ({ ...e }));\n\n      function keyLabel(code) {\n        return code\n          .replace(\"Key\", \"\")\n          .replace(\"Arrow\", \"\")\n          .replace(\"Digit\", \"\")\n          .replace(\"ShiftRight\", \"R-Shift\");\n      }\n\n      function renderControls() {\n        const list = document.getElementById(\"controls-list\");\n        list.innerHTML = \"\";\n        currentMap.forEach((entry, i) => {\n          const row = document.createElement(\"div\");\n          row.style.cssText =\n            \"display:flex;align-items:center;justify-content:space-between;gap:12px;\";\n          const label = document.createElement(\"span\");\n          label.style.cssText =\n            \"font-size:13px;font-weight:600;letter-spacing:0.04em;width:80px;\";\n          label.textContent = entry.action;\n          const btn = document.createElement(\"button\");\n          btn.style.cssText =\n            'font-family:\"DM Mono\",monospace;font-size:12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#e8e8e8;border-radius:6px;padding:6px 14px;cursor:pointer;min-width:110px;transition:border-color 0.15s;';\n          btn.textContent = keyLabel(entry.code);\n          btn.addEventListener(\"click\", () => {\n            btn.textContent = \"...\";\n            btn.style.borderColor = \"rgba(255,255,255,0.35)\";\n            const handler = (e) => {\n              e.preventDefault();\n              currentMap[i].code = e.code;\n              localStorage.setItem(\"azahar-keymap\", JSON.stringify(currentMap));\n              window.__applyKeymap?.(currentMap);\n              renderControls();\n              window.removeEventListener(\"keydown\", handler);\n            };\n            window.addEventListener(\"keydown\", handler);\n          });\n          row.append(label, btn);\n          list.appendChild(row);\n        });\n      }\n\n      document.getElementById(\"controls-btn\").addEventListener(\"click\", () => {\n        const m = document.getElementById(\"controls-modal\");\n        m.style.display = \"flex\";\n        renderControls();\n      });\n\n      document\n        .getElementById(\"controls-close\")\n        .addEventListener(\"click\", () => {\n          document.getElementById(\"controls-modal\").style.display = \"none\";\n        });\n\n      window.__applyKeymap = function (map) {\n        if (!window.__keymapRef) return;\n        window.__keymapRef.clear();\n        map.forEach(({ action, code }, i) => window.__keymapRef.set(code, i));\n      };\n    </script>\n\n    <script>\n      const boot = document.getElementById(\"boot-screen\");\n      const app = document.getElementById(\"app\");\n      const embedMode =\n        new URLSearchParams(window.location.search).get(\"embed\") === \"1\";\n\n      if (embedMode) {\n        document.body.classList.add(\"embed\");\n        app.classList.add(\"visible\");\n        boot.remove();\n      } else {\n        setTimeout(() => {\n          boot.style.transition = \"opacity 0.6s ease\";\n          boot.style.opacity = \"0\";\n          app.classList.add(\"visible\");\n          setTimeout(() => boot.remove(), 650);\n        }, 5100);\n      }\n\n      document\n        .getElementById(\"fullscreen-btn\")\n        .addEventListener(\"click\", () => {\n          if (!document.fullscreenElement)\n            document.documentElement.requestFullscreen();\n          else document.exitFullscreen();\n        });\n\n      document\n        .getElementById(\"save-state-btn\")\n        .addEventListener(\"click\", () => {\n          const btn = document.getElementById(\"export-state\");\n          if (btn && !btn.disabled) btn.click();\n        });\n\n      const dropOverlay = document.getElementById(\"drop-overlay\");\n\n      window.addEventListener(\"dragenter\", (e) => {\n        e.preventDefault();\n        dropOverlay.classList.add(\"active\");\n      });\n      dropOverlay.addEventListener(\"dragleave\", (e) => {\n        if (!dropOverlay.contains(e.relatedTarget))\n          dropOverlay.classList.remove(\"active\");\n      });\n      dropOverlay.addEventListener(\"dragover\", (e) => e.preventDefault());\n      dropOverlay.addEventListener(\"drop\", (e) => {\n        e.preventDefault();\n        dropOverlay.classList.remove(\"active\");\n        const file = e.dataTransfer.files[0];\n        if (!file) return;\n        const input = document.getElementById(\"import-state\");\n        const dt = new DataTransfer();\n        dt.items.add(file);\n        input.files = dt.files;\n        input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n      });\n\n      const coreDot = document.getElementById(\"core-dot\");\n      const coreText = document.getElementById(\"core-status-text\");\n\n      const coreStatusStub = document.getElementById(\"core-status\");\n      Object.defineProperty(coreStatusStub, \"className\", {\n        set(val) {\n          this._cn = val;\n          const kind = val.replace(\"status\", \"\").trim();\n          const map = { ready: \"ok\", error: \"err\", \"\": \"warn\" };\n          coreDot.className = \"core-dot \" + (map[kind] ?? kind);\n        },\n        get() {\n          return this._cn || \"status\";\n        },\n        configurable: true,\n      });\n    </script>\n\n    <script src=\"./app.js\"></script>\n  </body>\n</html>\n", "ravenfield.html": "<!-- ported by guyg -->\n<!DOCTYPE html>\n<html lang=\"en-us\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n    <title>Ravenfield</title>\n    <link rel=\"shortcut icon\" href=\"TemplateData/favicon.ico\">\n    <link rel=\"stylesheet\" href=\"TemplateData/style.css\">\n    <style>\n      html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #231F20; overflow: hidden; }\n      #unity-container { position: fixed; inset: 0; width: 100vw; height: 100vh; }\n      #unity-canvas { display: block; width: 100vw !important; height: 100vh !important; background: #231F20; outline: none; }\n      #unity-loading-bar {\n        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);\n        display: none;\n      }\n      #unity-footer { display: none !important; }\n      #unity-warning { position: fixed; left: 50%; top: 12px; transform: translateX(-50%); z-index: 10; }\n    </style>\n  </head>\n  <body>\n    <div id=\"unity-container\">\n      <canvas id=\"unity-canvas\" tabindex=\"-1\"></canvas>\n      <div id=\"unity-loading-bar\">\n        <div id=\"unity-logo\"></div>\n        <div id=\"unity-progress-bar-empty\">\n          <div id=\"unity-progress-bar-full\"></div>\n        </div>\n      </div>\n      <div id=\"unity-warning\"></div>\n    </div>\n    <script>\n      window.addEventListener(\"load\", function () {\n        alert(\"port is laggy especially on larger maps and bugs are to be expected\");\n      });\n      (function () {\n        var DATA_MARKER = \"Build/WebGL.data\";\n        var PART_COUNT = 23;\n        var PART_PREFIX = \"Build/WebGL.data.part.\";\n\n        function fetchAllParts(baseUrl) {\n          var origin = baseUrl.substring(0, baseUrl.lastIndexOf(\"Build/\"));\n          var urls = [];\n          for (var i = 0; i < PART_COUNT; i++) {\n            urls.push(origin + PART_PREFIX + String(i).padStart(3, \"0\"));\n          }\n          return Promise.all(urls.map(function (u) {\n            return fetch(u).then(function (r) {\n              if (!r.ok) throw new Error(\"Failed to fetch \" + u + \": \" + r.status);\n              return r.arrayBuffer();\n            });\n          })).then(function (buffers) {\n            var total = 0;\n            buffers.forEach(function (b) { total += b.byteLength; });\n            var out = new Uint8Array(total);\n            var offset = 0;\n            buffers.forEach(function (b) {\n              out.set(new Uint8Array(b), offset);\n              offset += b.byteLength;\n            });\n            return out.buffer;\n          });\n        }\n\n        function isDataUrl(url) {\n          if (!url) return false;\n          return url.indexOf(DATA_MARKER) !== -1 && url.indexOf(\".part.\") === -1;\n        }\n\n        var origFetch = window.fetch ? window.fetch.bind(window) : null;\n        if (origFetch) {\n          window.fetch = function (input, init) {\n            var url = (typeof input === \"string\") ? input : (input && input.url) || \"\";\n            if (!isDataUrl(url)) return origFetch(input, init);\n            return fetchAllParts(url).then(function (buf) {\n              return new Response(buf, {\n                status: 200,\n                headers: { \"Content-Type\": \"application/octet-stream\", \"Content-Length\": String(buf.byteLength) }\n              });\n            });\n          };\n        }\n\n        var XHR = window.XMLHttpRequest;\n        var origOpen = XHR.prototype.open;\n        var origSend = XHR.prototype.send;\n        var origSetRH = XHR.prototype.setRequestHeader;\n        XHR.prototype.open = function (method, url) {\n          this.__url = url;\n          this.__method = method;\n          this.__intercept = (method.toUpperCase() === \"GET\") && isDataUrl(url);\n          if (this.__intercept) {\n            this.__listeners = { load: [], loadend: [], progress: [], error: [], abort: [], readystatechange: [] };\n          }\n          return origOpen.apply(this, arguments);\n        };\n        XHR.prototype.setRequestHeader = function () {\n          if (this.__intercept) return;\n          return origSetRH.apply(this, arguments);\n        };\n        var addEL = XHR.prototype.addEventListener;\n        XHR.prototype.addEventListener = function (type, fn) {\n          if (this.__intercept && this.__listeners[type]) {\n            this.__listeners[type].push(fn);\n            return;\n          }\n          return addEL.apply(this, arguments);\n        };\n        XHR.prototype.send = function () {\n          if (!this.__intercept) return origSend.apply(this, arguments);\n          var xhr = this;\n          var fire = function (type, ev) {\n            ev = ev || { type: type, target: xhr, currentTarget: xhr };\n            var arr = (xhr.__listeners && xhr.__listeners[type]) || [];\n            arr.forEach(function (fn) { try { fn.call(xhr, ev); } catch (e) { console.error(e); } });\n            var on = xhr[\"on\" + type];\n            if (typeof on === \"function\") { try { on.call(xhr, ev); } catch (e) { console.error(e); } 