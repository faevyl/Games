  async function scanLite() {
    var files;
    try {
      var res = await fetch(API);
      files = await res.json();
      if (!Array.isArray(files)) files = [];
    } catch (e) {
      return;
    }
    var queue = files.filter(function (f) {
      if (!f || f.type !== "file" || !/\.html$/i.test(f.name) || BLOCK_FILE[f.name]) return false;
      var n = f.name.toLowerCase();
      var sz = f.size || 0;
      if (n.indexOf("gba") !== -1 || n.indexOf("nes") !== -1 || n.indexOf("n64") !== -1) return false;
      if (/flash|ruffle|swf|achill|riddle|cookie|granny|burger|fnaf|gun-mayhem|ragdoll|alchem|infinite-craft|drive-mad|escape-road|parenting|isaac/.test(n)) return true;
      if (/ds|dsi|nds/.test(n) && !/lands|roads|cards|words|birds|mods/.test(n)) return true;
      if (sz >= 900 && sz <= 1600) return true;
      if (sz >= 2400 && sz <= 4500) return true;
      return false;
    });
    var i = 0;
    async function worker() {
      while (i < queue.length) {
        var f = queue[i++];
        if (games[f.name]) continue;
        try {
          var txt = await fetchText(liteUrl(f.name));
          var info = classify(txt);
          if (info) {
            add(f.name, info.kind, info.url);
            render();
          }
        } catch (e) {}
      }
    }
    await Promise.all([worker(), worker(), worker(), worker()]);
  }

