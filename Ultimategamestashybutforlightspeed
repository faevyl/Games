  async function play(file) {
    var g = games[file];
    if (!g) return;
    var blob = (g.file + " " + g.name + " " + (g.dest || "")).toLowerCase();
    if (/roblox/.test(blob)) {
      chromeNote("yk i cant load roblox, sorry...");
      return;
    }
    sel = file;
    document.body.classList.add("playing");
    document.getElementById("empty").className = "hide";
    setLoad(true, "loading " + g.name + "…");
    layout();
    render();
    var url = pageUrl(g);
    try {
      var txt = await fetchText(url);
      var html = fixGameHtml(innerHtml(txt));
      var info = classify(txt);
      var swf = "";
      if (info && info.url) {
        var abs = info.url;
        if (!/^https?:/i.test(abs)) abs = dirOf(mirrors(url)[0]) + abs.replace(/^\.\//, "");
        abs = cleanUrl(abs);
        var pageDest = g.dest && /\.html($|\?)/i.test(g.dest);
        if (!destBlocked(abs) && !pageDest) {
          g.dest = abs;
          if (info.kind) g.kind = info.kind;
        }
        if (info.kind === "flash" || /\.swf($|\?)/i.test(abs)) swf = abs;
      }
      if (html && /createUnityInstance|unity-canvas|UnityLoader/i.test(html)) {
        show(withBase(html, dirOf(mirrors(url)[0])));
        return;
      }
      var pageDest = g.dest && /\.html($|\?)/i.test(g.dest);
      if (pageDest) {
        show(withBase(html, dirOf(mirrors(url)[0])));
        return;
      }
      if (swf && /\.swf($|\?)/i.test(swf) && !destBlocked(swf)) {
        show(ruffleDoc(swf));
        return;
      }
      var cdnPage = ownCdnBase(html);
      var needsFix = /[0-9a-f]{8,}-text\/javascript/i.test(txt);
      if (cdnPage && !needsFix) {
        playUrl(mirrors(url)[0]);
        return;
      }
      if (html && /EJS_|poki-sdk|emscripten|type=["']module["']/i.test(html)) {
        show(withBase(html, cdnPage || dirOf(mirrors(url)[0])));
        return;
      }
    } catch (e) {}
    var dest = g.dest;
    if (dest && destBlocked(dest)) { hideLoad(); return; }
    if (dest && /\.swf/i.test(dest)) {
      show(ruffleDoc(dest));
      return;
    }
    if (g.kind === "nds" && dest) {
      show(ndsDoc(dest));
      return;
    }
    if (dest && /\.json$/i.test(dest)) {
      dest = dest.replace(/\/Build\/[^/]+\.json$/i, "/index.html");
      if (destBlocked(dest)) { hideLoad(); return; }
      url = dest;
    }
    playUrl(url);
  }

