nt(\"script\");\n          script.src = BUILD + \"/\" + MANIFEST.loader.file;\n          script.onload = function () {\n            createUnityInstance(canvas, {\n              dataUrl: dataUrl,\n              frameworkUrl: frameworkUrl,\n              codeUrl: codeUrl,\n              streamingAssetsUrl: \"StreamingAssets\",\n              companyName: \"Aggro Crab & Landfall\",\n              productName: \"PEAK\",\n              productVersion: \"1.62.a\",\n            }, function (p) {\n              bar.style.display = \"block\";\n              barfill.style.width = Math.round(p * 100) + \"%\";\n              setMsg(\"Loading\u2026 \" + Math.round(p * 100) + \"%\");\n            }).then(function (instance) {\n              window.unityInstance = instance;\n              bar.style.display = \"none\";\n              setMsg(\"\");\n              // Unity's own SetFullscreen keeps the canvas sized to the screen; the\n              // Fullscreen API on the element alone leaves the render target unchanged.\n              var fs = document.querySelector(\"#fs\");\n              fs.style.display = \"block\";\n              fs.onclick = function () {\n                if (instance.SetFullscreen) instance.SetFullscreen(1);\n                else if (canvas.requestFullscreen) canvas.requestFullscreen();\n                canvas.focus();\n              };\n            }).catch(function (e) {\n              setMsg(\"Failed to start: \" + e);\n            });\n          };\n          script.onerror = function () { setMsg(\"Failed to load \" + script.src); };\n          document.body.appendChild(script);\n        } catch (e) {\n          setMsg(String(e));\n        }\n      })();\n    </script>\n  </body>\n</html>\n", "among-us.html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <title>Among Us - wasm.rip</title>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <style>\n      * {\n        margin: 0;\n   