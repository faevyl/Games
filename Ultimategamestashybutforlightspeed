  async function play(file) {
    var g = games[file];
    if (!g) return;
    var blob = (g.file + " " + g.name + " " + (g.dest || "")).toLowerCase();
    if (/roblox/.test(blob)) {
      chromeNote("yk i cant load roblox, sorry...");
      return;
    }
    sel = file;
    document.body.classList.add("playing");
    document.getElementById("empty").className = "hide";
    setLoad(true, "loading " + g.name + "…");
    layout();
    render();
    if (file === "sonic-mania.html") {
      show(sonicManiaDoc());
      return;
    }
    if (file === "brotato.html") {
      show(brotatoDoc());
      return;
    }
    if (WASM_RIP_HTML[file]) {
      show(wasmRipDoc(file));
      return;
    }
    if (file === "flesh-engine.html") {
      show(fleshEngineDoc());
      return;
    }
    if (file === "worm-ca.html") {
      show(wormCaDoc());
      return;
    }
    if (LIVE_PAGE[file]) {
      try {
        var livePage = pageUrl(g);
        playHtml(fixGameHtml(innerHtml(await fetchText(livePage))), dirOf(mirrors(livePage)[0]));
      } catch (e) {
        if (offlineMode) {
          chromeNote("open that one once while online first");
          hideLoad();
          return;
        }
        playUrl(pageUrl(g));
      }
      return;
    }
    if (file === "ragdoll-archers/index.html") {
      show(withBase(ragdollDoc(), CDN + LITE + "ragdoll-archers/"));
      return;
    }
    if (file === "kindergarten.html") {
      show(withBase(await webportDoc(1), "https://raw.githubusercontent.com/genizy/web-port/main/kindergarten/1/"));
      return;
    }
    if (file === "kindergarten-2.html") {
      show(withBase(await webportDoc(2), "https://raw.githubusercontent.com/genizy/web-port/main/kindergarten/2/"));
      return;
    }
    if (UNITY_SPLIT[file]) {
      show(withBase(unitySplitDoc(UNITY_SPLIT[file]), UNITY_SPLIT[file].bases[0]));
      return;
    }
    var url = pageUrl(g);
    try {
      var txt = await fetchText(url);
      var html = fixGameHtml(innerHtml(txt));
      var info = classify(txt);
      var swf = "";
      if (info && info.url) {
        var abs = info.url;
        if (!/^https?:/i.test(abs)) abs = dirOf(mirrors(url)[0]) + abs.replace(/^\.\//, "");
        abs = cleanUrl(abs);
        var pageDest = g.dest && /\.html($|\?)/i.test(g.dest);
        if (!destBlocked(abs) && !pageDest) {
          g.dest = abs;
          if (info.kind) g.kind = info.kind;
        }
        if (info.kind === "flash" || /\.swf($|\?)/i.test(abs)) swf = abs;
      }
      if (swf && /\.swf($|\?)/i.test(swf) && !destBlocked(swf)) {
        show(ruffleDoc(swf));
        return;
      }
      var live = mirrors(url)[0];
      if (g.kind !== "nds" && html && (needsLiveOrigin(html) || g.kind === "web")) {
        playHtml(html, ownCdnBase(html) || dirOf(live));
        return;
      }
      if (html && /EJS_/i.test(html)) {
        show(withBase(html, ownCdnBase(html) || dirOf(live)));
        return;
      }
    } catch (e) {}
    var dest = g.dest;
    if (dest && destBlocked(dest)) { hideLoad(); return; }
    if (dest && /\.swf/i.test(dest)) {
      show(ruffleDoc(dest));
      return;
    }
    if (g.kind === "nds" && dest) {
      show(ndsDoc(dest));
      return;
    }
    if (dest && /\.json$/i.test(dest)) {
      dest = dest.replace(/\/Build\/[^/]+\.json$/i, "/index.html");
      if (destBlocked(dest)) { hideLoad(); return; }
      url = dest;
    }
    if (offlineMode) {
      chromeNote("open that one once while online first");
      hideLoad();
      return;
    }
    playUrl(url);
  }

  function saveCache() {
    try {
      localStorage.setItem("liteFlashDs11", JSON.stringify({ t: Date.now(), games: games }));
    } catch (e) {}
  }

  function loadCache() {
    try {
      var raw = localStorage.getItem("liteFlashDs11");
      if (!raw) return;
      var data = JSON.parse(raw);
      if (!data || !data.games || Date.now() - data.t > 7 * 24 * 60 * 60 * 1000) return;
      Object.keys(data.games).forEach(function (file) {
        var g = data.games[file];
        add(file, g.kind, g.dest);
      });
    } catch (e) {}
  }

  async function scanLite() {
    var files;
    try {
      var res = await fetch(API);
      files = await res.json();
      if (!Array.isArray(files)) files = [];
    } catch (e) {
      return;
    }
    var queue = files.filter(function (f) {
      if (!f || f.type !== "file" || !/\.html$/i.test(f.name) || BLOCK_FILE[f.name]) return false;
      var n = f.name.toLowerCase();
      var sz = f.size || 0;
      if (n.indexOf("gba") !== -1 || n.indexOf("nes") !== -1 || n.indexOf("n64") !== -1) return false;
      if (/flash|ruffle|swf|achill|riddle|cookie|granny|burger|fnaf|gun-mayhem|ragdoll|drive-mad|escape-road|parenting|slope|duck-life|papa|raft-wars|strike-force|fireboy|bitlife|2048|ovo|retro-bowl|helix|cluster|subway|run-3|friday-night|funkin|hobo|bloxorz|stick-rpg|stick-war|super-fighters|burrito|doodle|pacman|tetris|red-ball|factory-balls|flood-runner|basket-random|boxing-random|soccer-random|angry-birds|getaway|super-hot|bad-ice|bubble-tanks|amorphous|bad-piggies|hextris|chrome-dino|dark-room|interactive-buddy|brotato|sonic-mania|batim|miside|cuphead|oneshot|helltaker|stardew|inscryption|lobotomy|granny-3|peak|among-us|gta-3|azahar|ravenfield|trombone|clustertruck|plague|fez|beatblock|scp|how-to-fish|global-strike|happy-room|cheese-rolling|boil-noodles|dice-a-million|man-from-window|ages-of-conflict|while-true/.test(n)) return true;
      if (/(^|-)(ds|dsi|nds)\.html$/.test(n) || /mario-kart-ds|mario-party-ds|super-mario-64-ds|animal-crossing-wild-world/.test(n)) return true;
      if (sz >= 900 && sz <= 1600) return true;
      if (sz >= 2400 && sz <= 4500) return true;
      return false;
    });
    var i = 0;
    async function worker() {
      while (i < queue.length) {
        var f = queue[i++];
        if (games[f.name]) continue;
        try {
          var txt = await fetchText(liteUrl(f.name));
          var info = classify(txt);
          if (info) {
            add(f.name, info.kind, info.url);
            render();
          }
        } catch (e) {}
      }
    }
    await Promise.all([worker(), worker(), worker(), worker()]);
  }

  async function scanSeraph() {
    return;
  }

  async function scan() {
    setLoad(true, offlineMode ? "offline…" : "loading games…");
    document.getElementById("stat").textContent = offlineMode ? "offline" : "scanning…";
    if (offlineMode) {
      render();
      bootPlay();
      if (!sel) hideLoad();
      return;
    }
    await scanLite();
    await scanSeraph();
    saveCache();
    render();
    bootPlay();
    if (!sel) hideLoad();
  }

  document.getElementById("noteX").addEventListener("click", function () {
    document.getElementById("note").className = "";
  });
  document.getElementById("list").addEventListener("click", function (e) {
    var b = e.target.closest("[data-file]");
    if (b) play(b.getAttribute("data-file"));
  });
  document.getElementById("tabs").addEventListener("click", function (e) {
    var b = e.target.closest("[data-tab]");
    if (!b) return;
    tab = b.getAttribute("data-tab");
    [].forEach.call(document.querySelectorAll("#tabs button"), function (x) {
      x.className = x === b ? "on" : "";
    });
    render();
  });
  document.getElementById("q").addEventListener("input", function () {
    query = this.value;
    render();
  });
  document.getElementById("back").addEventListener("click", function () {
    var frame = document.getElementById("frame");
    dropPageBlob();
    frame.srcdoc = "";
    frame.src = "about:blank";
    document.body.classList.remove("playing");
    document.getElementById("empty").className = "";
    hideLoad();
    sel = null;
    exitMax();
    closeSheet();
    layout();
    render();
  });

  function fsEl() {
    return document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement || null;
  }
  function canNativeFs() {
    if (document.fullscreenEnabled || document.webkitFullscreenEnabled || document.msFullscreenEnabled) return true;
    try {
      if (document.featurePolicy && document.featurePolicy.allowsFeature) return document.featurePolicy.allowsFeature("fullscreen");
    } catch (e) {}
    return false;
  }
  function askFs(el) {
    if (!el) return Promise.reject();
    try {
      if (el.requestFullscreen) return el.requestFullscreen();
      if (el.webkitRequestFullscreen) {
        el.webkitRequestFullscreen();
        return Promise.resolve();
      }
      if (el.msRequestFullscreen) {
        el.msRequestFullscreen();
        return Promise.resolve();
      }
    } catch (e) {
      return Promise.reject(e);
    }
    return Promise.reject();
  }
  function exitFs() {
    try {
      if (document.exitFullscreen) return document.exitFullscreen();
      if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
      if (document.msExitFullscreen) return document.msExitFullscreen();
    } catch (e) {}
  }
  function enterMax() {
    document.body.classList.add("max");
    document.getElementById("full").className = "on";
    layout();
  }
  function exitMax() {
    document.body.classList.remove("max");
    document.getElementById("full").className = "";
    layout();
  }
  function goFull() {
    if (fsEl()) {
      exitFs();
      exitMax();
      return;
    }
    if (document.body.classList.contains("max")) {
      exitMax();
      return;
    }
    if (!canNativeFs()) {
      enterMax();
      return;
    }
    var box = document.getElementById("play");
    var p = askFs(box);
    if (p && p.then) {
      p.then(function () {
        if (fsEl()) { document.getElementById("full").className = "on"; layout(); }
        else enterMax();
      }).catch(function () { enterMax(); });
    } else {
      setTimeout(function () {
        if (fsEl()) { document.getElementById("full").className = "on"; layout(); }
        else enterMax();
      }, 80);
    }
  }
  function onFsChange() {
    if (!fsEl()) document.getElementById("full").className = document.body.classList.contains("max") ? "on" : "";
    else document.getElementById("full").className = "on";
    layout();
  }
  function bootPlay() {
    if (bootGame && games[bootGame] && !sel) play(bootGame);
  }

  document.getElementById("full").addEventListener("click", goFull);
  document.addEventListener("fullscreenchange", onFsChange);
  document.addEventListener("webkitfullscreenchange", onFsChange);

  function applyTheme(id) {
    var ok = false, i;
    for (i = 0; i < THEMES.length; i++) if (THEMES[i][0] === id) ok = true;
    if (!ok) id = "why";
    document.documentElement.setAttribute("data-theme", id);
    try { localStorage.setItem("whyRevivedTheme", id); } catch (e) {}
    [].forEach.call(document.querySelectorAll("#themes button"), function (b) {
      b.className = b.getAttribute("data-theme") === id ? "on" : "";
    });
  }
  function openSheet(kind) {
    document.getElementById("sheet").className = "on";
    document.getElementById("sheetTitle").textContent = kind === "theme" ? "THEMES" : "UPDATE LOG";
    document.getElementById("logPane").style.display = kind === "theme" ? "none" : "block";
    document.getElementById("themePane").style.display = kind === "theme" ? "block" : "none";
    document.getElementById("logBtn").className = kind === "log" ? "on" : "";
    document.getElementById("themeBtn").className = kind === "theme" ? "on" : "";
  }
  function closeSheet() {
    document.getElementById("sheet").className = "";
    document.getElementById("logBtn").className = "";
    document.getElementById("themeBtn").className = "";
  }
  document.getElementById("logPane").innerHTML = LOGS.map(function (row) {
    return '<div class="log"><b>' + row[0] + "</b><p>" + row[1] + "</p></div>";
  }).join("");
  document.getElementById("themes").innerHTML = THEMES.map(function (row) {
    return '<button type="button" data-theme="' + row[0] + '">' + row[1] + "</button>";
  }).join("");
  document.getElementById("themes").addEventListener("click", function (e) {
    var b = e.target.closest("[data-theme]");
    if (b) applyTheme(b.getAttribute("data-theme"));
  });
  document.getElementById("logBtn").addEventListener("click", function () { openSheet("log"); });
  document.getElementById("themeBtn").addEventListener("click", function () { openSheet("theme"); });
  function paintOff() {
    var b = document.getElementById("offBtn");
    if (b) b.className = offlineMode ? "on" : "";
  }
  paintOff();
  document.getElementById("offBtn").addEventListener("click", function () {
    offlineMode = !offlineMode;
    try { localStorage.setItem("whyRevivedOffline", offlineMode ? "1" : "0"); } catch (e) {}
    paintOff();
    chromeNote(offlineMode ? "offline. games you already opened on this page will play. open a game once while online first" : "online");
    render();
  });
  document.getElementById("sheetX").addEventListener("click", closeSheet);
  document.getElementById("sheet").addEventListener("click", function (e) {
    if (e.target === this) closeSheet();
  });
  try { applyTheme(localStorage.getItem("whyRevivedTheme") || "why"); } catch (e) { applyTheme("why"); }

  loadCache();
  render();
  layout();
  if (bootGame) enterMax();
  bootPlay();
  window.addEventListener("resize", layout);
  if (window.visualViewport) window.visualViewport.addEventListener("resize", layout);
  scan();
})();
