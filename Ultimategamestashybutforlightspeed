<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mirror Maze</title>
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  #c { display: block; width: 100%; height: 100%; cursor: crosshair; }
  #ui {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    color: #c8e8ff; font-family: Consolas, "Courier New", monospace;
    background: rgba(0, 4, 12, 0.78); pointer-events: none;
  }
  #ui h1 {
    font-weight: 400; letter-spacing: 14px; font-size: 42px; margin: 0 0 10px;
    text-shadow: 0 0 28px #4aa8ff;
  }
  #ui p { margin: 6px 0; color: #6a8aaa; letter-spacing: 2px; font-size: 13px; }
  #ui .big { color: #e8f4ff; font-size: 15px; margin-top: 18px; }
  #hud {
    position: fixed; left: 0; right: 0; bottom: 18px; text-align: center;
    color: #4a6a88; font: 12px Consolas, monospace; letter-spacing: 1px;
    pointer-events: none; display: none;
  }
  #cross {
    position: fixed; top: 50%; left: 50%; width: 7px; height: 7px;
    margin: -4px 0 0 -4px; border: 1px solid #9fd4ff; border-radius: 50%;
    opacity: 0.4; pointer-events: none; display: none;
  }
  #err {
    position: fixed; top: 10px; left: 10px; color: #ff6b6b;
    font: 12px Consolas, monospace; white-space: pre-wrap; display: none;
  }
  #map { display: none !important; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<canvas id="map" width="148" height="148"></canvas>
<div id="cross"></div>
<div id="ui">
  <h1>MIRROR MAZE</h1>
  <p>DON'T TRUST WHAT YOU SEE</p>
  <p class="big">CLICK TO START</p>
  <p>WASD MOVE &nbsp; MOUSE LOOK &nbsp; SHIFT SPRINT</p>
  <p>R NEW MAZE &nbsp;·&nbsp; FIND THE WARM LIGHT</p>
</div>
<div id="hud">every corridor is a reflection · find the warm light</div>
<div id="err"></div>
<script>
(function () {
  var errEl = document.getElementById("err");
  window.onerror = function (msg, src, line) {
    errEl.style.display = "block";
    errEl.textContent = msg + "\n" + src + ":" + line;
  };

  var canvas = document.getElementById("c");
  var gl = canvas.getContext("webgl2", { antialias: false, alpha: false });
  if (!gl) {
    errEl.style.display = "block";
    errEl.textContent = "WebGL2 is required for the raytraced maze.";
    return;
  }

  var N = 32;
  var maze = new Uint8Array(N * N);
  var start = [1.5, 1.5];
  var exitC = [N - 2.5, N - 2.5];

  function genMaze() {
    var i, x, y;
    for (i = 0; i < N * N; i++) maze[i] = 255;
    function id(cx, cy) { return cy * N + cx; }
    function carve(cx, cy) {
      maze[id(cx, cy)] = 0;
      var dirs = [[2, 0], [-2, 0], [0, 2], [0, -2]];
      var k, j, t, nx, ny;
      for (k = 0; k < 4; k++) {
        j = k + (Math.random() * (4 - k) | 0);
        t = dirs[k]; dirs[k] = dirs[j]; dirs[j] = t;
      }
      for (k = 0; k < 4; k++) {
        nx = cx + dirs[k][0];
        ny = cy + dirs[k][1];
        if (nx > 0 && ny > 0 && nx < N - 1 && ny < N - 1 && maze[id(nx, ny)]) {
          maze[id(cx + dirs[k][0] / 2, cy + dirs[k][1] / 2)] = 0;
          carve(nx, ny);
        }
      }
    }
    carve(1, 1);
    for (i = 0; i < 18; i++) {
      x = 2 + (Math.random() * (N - 4) | 0);
      y = 2 + (Math.random() * (N - 4) | 0);
      if (!maze[id(x, y)] || Math.random() < 0.35) maze[id(x, y)] = 0;
    }
    start = [1.5, 1.5];
    var best = 0, bx = N - 2, by = N - 2;
    for (y = 1; y < N - 1; y++) {
      for (x = 1; x < N - 1; x++) {
        if (maze[id(x, y)]) continue;
        var d = (x - 1) * (x - 1) + (y - 1) * (y - 1);
        if (d > best) { best = d; bx = x; by = y; }
      }
    }
    exitC = [bx + 0.5, by + 0.5];
  }

  var vs = `#version 300 es
in vec2 aPos;
void main(){ gl_Position = vec4(aPos, 0.0, 1.0); }`;

  var fs = `#version 300 es
precision highp float;
uniform sampler2D uMaze;
uniform vec2 uSize;
uniform vec3 uCam;
uniform vec3 uFwd, uRight, uUp;
uniform vec2 uExit;
uniform float uTime;
uniform vec2 uRes;
out vec4 fragColor;

bool occupied(ivec2 c) {
  if (c.x < 0 || c.y < 0 || c.x >= int(uSize.x) || c.y >= int(uSize.y)) return true;
  return texelFetch(uMaze, c, 0).r > 0.5;
}

const float CEIL_Y = 2.35;
const float HIT_EPS = 4e-4;

vec3 sky(vec3 rd) {
  return vec3(0.006, 0.007, 0.01);
}

vec3 ceilEmit(vec3 p) {
  vec2 f = fract(p.xz) - 0.5;
  float lamp = exp(-90.0 * dot(f, f));
  float gold = exp(-6.5 * dot(p.xz - uExit, p.xz - uExit));
  return vec3(0.92, 0.96, 1.0) * lamp * 5.5 + vec3(1.0, 0.55, 0.12) * gold * 9.0;
}

float nextGridT(float s0, float ds, float t0) {
  if (abs(ds) < 1e-12) return 1e30;
  float s = s0 + ds * t0;
  float plane = ds > 0.0 ? floor(s + 1e-5) + 1.0 : ceil(s - 1e-5) - 1.0;
  return (plane - s0) / ds;
}

bool traceHit(vec3 ro, vec3 rd, out vec3 pHit, out vec3 nHit, out int kind) {
  nHit = vec3(0.0);
  pHit = ro;
  kind = 0;

  ivec2 c0 = ivec2(floor(ro.xz));
  if (occupied(c0)) {
    vec2 f = fract(ro.xz);
    if (min(f.x, 1.0 - f.x) < min(f.y, 1.0 - f.y))
      ro.x += (f.x < 0.5 ? -1.0 : 1.0) * (min(f.x, 1.0 - f.x) + 0.004);
    else
      ro.z += (f.y < 0.5 ? -1.0 : 1.0) * (min(f.y, 1.0 - f.y) + 0.004);
  }

  float tFloor = rd.y < -1e-8 ? (0.0 - ro.y) / rd.y : 1e30;
  float tCeil = rd.y > 1e-8 ? (CEIL_Y - ro.y) / rd.y : 1e30;
  float tCursor = 0.0;

  for (int i = 0; i < 80; i++) {
    float tX = nextGridT(ro.x, rd.x, tCursor + HIT_EPS);
    float tZ = nextGridT(ro.z, rd.z, tCursor + HIT_EPS);
    float tPlane = min(tX, tZ);
    float tHit = min(tPlane, min(tFloor, tCeil));
    if (tHit > 48.0) break;

    if (tFloor > HIT_EPS && tFloor <= tHit + 1e-6) {
      kind = 1;
      nHit = vec3(0.0, 1.0, 0.0);
      pHit = ro + rd * tFloor;
      pHit.y = 0.0;
      return true;
    }
    if (tCeil > HIT_EPS && tCeil <= tHit + 1e-6) {
      kind = 2;
      nHit = vec3(0.0, -1.0, 0.0);
      pHit = ro + rd * tCeil;
      pHit.y = CEIL_Y;
      return true;
    }

    bool xSide = tX <= tZ;
    float t = tPlane;
    vec3 before = ro + rd * (t - 1e-4);
    vec3 after = ro + rd * (t + 1e-4);
    ivec2 from = ivec2(floor(before.xz));
    ivec2 to = ivec2(floor(after.xz));
    ivec2 toX = ivec2(to.x, from.y);
    ivec2 toZ = ivec2(from.x, to.y);
    bool hitX = !occupied(from) && occupied(toX);
    bool hitZ = !occupied(from) && occupied(toZ);
    if (!hitX && !hitZ && !occupied(from) && occupied(to)) {
      if (xSide) hitX = true;
      else hitZ = true;
    }
    if (hitX || hitZ) {
      kind = 3;
      if (hitX && (!hitZ || xSide)) {
        float plane = rd.x > 0.0 ? float(toX.x) : float(from.x);
        nHit = vec3(rd.x > 0.0 ? -1.0 : 1.0, 0.0, 0.0);
        pHit = ro + rd * ((plane - ro.x) / rd.x);
        pHit.x = plane;
      } else {
        float plane = rd.z > 0.0 ? float(toZ.y) : float(from.y);
        nHit = vec3(0.0, 0.0, rd.z > 0.0 ? -1.0 : 1.0);
        pHit = ro + rd * ((plane - ro.z) / rd.z);
        pHit.z = plane;
      }
      return true;
    }
    tCursor = t;
  }
  return false;
}

vec3 shade(vec3 ro, vec3 rd) {
  vec3 col = vec3(0.0);
  vec3 att = vec3(1.0);
  vec3 o = ro;
  vec3 d = rd;
  for (int bounce = 0; bounce < 12; bounce++) {
    vec3 p;
    vec3 n;
    int kind;
    if (!traceHit(o, d, p, n, kind)) {
      col += att * sky(d);
      break;
    }
    if (kind == 2) col += att * ceilEmit(p);
    att *= vec3(0.985, 0.99, 0.995);
    o = p + n * 0.005;
    if (abs(n.x) > 0.5) d.x = -d.x;
    else if (abs(n.z) > 0.5) d.z = -d.z;
    else d.y = -d.y;
  }
  return col;
}

void main() {
  vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
  vec3 rd = normalize(uFwd + (uv.x * uRight + uv.y * uUp) * 0.72);
  vec3 col = shade(uCam, rd);
  col = col / (col + vec3(0.85));
  col = pow(max(col, vec3(0.0)), vec3(0.88));
  fragColor = vec4(col, 1.0);
}`;

  function compile(type, src) {
    var sh = gl.createShader(type);
    gl.shaderSource(sh, src);
    gl.compileShader(sh);
    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
      throw new Error(gl.getShaderInfoLog(sh) || "shader compile failed");
    }
    return sh;
  }

  var prog;
  try {
    prog = gl.createProgram();
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      throw new Error(gl.getProgramInfoLog(prog) || "shader link failed");
    }
  } catch (e) {
    errEl.style.display = "block";
    errEl.textContent = String(e && e.message ? e.message : e);
    return;
  }
  gl.useProgram(prog);

  var buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
  var loc = gl.getAttribLocation(prog, "aPos");
  gl.enableVertexAttribArray(loc);
  gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

  var tex = gl.createTexture();
  gl.activeTexture(gl.TEXTURE0);
  gl.bindTexture(gl.TEXTURE_2D, tex);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

  function uploadMaze() {
    var rgba = new Uint8Array(N * N * 4);
    var i;
    for (i = 0; i < N * N; i++) {
      var v = maze[i];
      rgba[i * 4] = v;
      rgba[i * 4 + 1] = v;
      rgba[i * 4 + 2] = v;
      rgba[i * 4 + 3] = 255;
    }
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAX_LEVEL, 0);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, N, N, 0, gl.RGBA, gl.UNSIGNED_BYTE, rgba);
    var err = gl.getError();
    if (err) {
      errEl.style.display = "block";
      errEl.textContent = "maze texture error " + err;
    }
  }

  var U = {};
  ["uMaze", "uSize", "uCam", "uFwd", "uRight", "uUp", "uExit", "uTime", "uRes"].forEach(function (name) {
    U[name] = gl.getUniformLocation(prog, name);
  });
  gl.uniform1i(U.uMaze, 0);
  gl.uniform2f(U.uSize, N, N);

  var cam = { x: 1.5, y: 1.15, z: 1.5, yaw: 0.2, pitch: 0.0 };
  var keys = {};
  var playing = false;
  var last = 0;
  var scale = Math.min(1, 900 / Math.max(window.innerWidth, 1));

  function blocked(x, z) {
    var cx = x | 0, cz = z | 0;
    if (cx < 0 || cz < 0 || cx >= N || cz >= N) return true;
    return maze[cz * N + cx] > 0;
  }

  function moveTo(nx, nz) {
    var r = 0.16;
    if (!blocked(nx - r, cam.z - r) && !blocked(nx + r, cam.z - r) &&
        !blocked(nx - r, cam.z + r) && !blocked(nx + r, cam.z + r)) cam.x = nx;
    if (!blocked(cam.x - r, nz - r) && !blocked(cam.x + r, nz - r) &&
        !blocked(cam.x - r, nz + r) && !blocked(cam.x + r, nz + r)) cam.z = nz;
  }

  function resetCam() {
    cam.x = start[0];
    cam.z = start[1];
    cam.y = 1.15;
    cam.yaw = 0.15;
    cam.pitch = 0;
  }

  function newMaze() {
    genMaze();
    uploadMaze();
    resetCam();
    gl.uniform2f(U.uExit, exitC[0], exitC[1]);
  }
  newMaze();

  function resize() {
    var w = Math.max(1, (window.innerWidth * scale) | 0);
    var h = Math.max(1, (window.innerHeight * scale) | 0);
    canvas.width = w;
    canvas.height = h;
    gl.viewport(0, 0, w, h);
    gl.uniform2f(U.uRes, w, h);
  }
  window.addEventListener("resize", resize);
  resize();

  document.addEventListener("keydown", function (e) {
    keys[e.code] = true;
    if (e.code === "KeyR" && playing) newMaze();
    if (e.code === "Space") e.preventDefault();
  });
  document.addEventListener("keyup", function (e) { keys[e.code] = false; });

  canvas.addEventListener("click", function () {
    canvas.requestPointerLock();
  });
  document.addEventListener("pointerlockchange", function () {
    playing = document.pointerLockElement === canvas;
    document.getElementById("ui").style.display = playing ? "none" : "flex";
    document.getElementById("hud").style.display = playing ? "block" : "none";
    document.getElementById("cross").style.display = playing ? "block" : "none";
  });
  document.addEventListener("mousemove", function (e) {
    if (!playing) return;
    cam.yaw += e.movementX * 0.0022;
    cam.pitch = Math.max(-1.2, Math.min(1.2, cam.pitch - e.movementY * 0.0022));
  });

  function frame(now) {
    var dt = Math.min(0.05, (now - last) / 1000 || 0.016);
    last = now;
    if (playing) {
      var sp = (keys.ShiftLeft || keys.ShiftRight ? 3.6 : 2.15) * dt;
      var fx = Math.sin(cam.yaw), fz = Math.cos(cam.yaw);
      var rx = Math.cos(cam.yaw), rz = -Math.sin(cam.yaw);
      var mx = 0, mz = 0;
      if (keys.KeyW) { mx += fx; mz += fz; }
      if (keys.KeyS) { mx -= fx; mz -= fz; }
      if (keys.KeyD) { mx += rx; mz += rz; }
      if (keys.KeyA) { mx -= rx; mz -= rz; }
      var len = Math.hypot(mx, mz);
      if (len > 0) moveTo(cam.x + mx / len * sp, cam.z + mz / len * sp);
    }

    var cp = Math.cos(cam.pitch), spn = Math.sin(cam.pitch);
    var cy = Math.cos(cam.yaw), sy = Math.sin(cam.yaw);
    var fwd = [sy * cp, spn, cy * cp];
    var right = [cy, 0, -sy];
    var up = [-sy * spn, cp, -cy * spn];

    gl.uniform3f(U.uCam, cam.x, cam.y, cam.z);
    gl.uniform3f(U.uFwd, fwd[0], fwd[1], fwd[2]);
    gl.uniform3f(U.uRight, right[0], right[1], right[2]);
    gl.uniform3f(U.uUp, up[0], up[1], up[2]);
    gl.uniform1f(U.uTime, now * 0.001);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
