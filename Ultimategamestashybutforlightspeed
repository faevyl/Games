ssive: false });\n  document.getElementById(\"cover\").addEventListener(\"click\", begin);\n  document.getElementById(\"dead\").addEventListener(\"click\", begin);\n\n  var pads = document.getElementById(\"pads\");\n  if (window.matchMedia && window.matchMedia(\"(pointer: coarse)\").matches) pads.className = \"on\";\n  pads.addEventListener(\"pointerdown\", function (e) {\n    var b = e.target.closest(\"button\");\n    if (!b) return;\n    e.preventDefault();\n    if (mode !== \"play\") { begin(); return; }\n    var a = b.getAttribute(\"data-act\");\n    if (a === \"jump\") keys.Space = 1;\n    if (a === \"dash\") dash();\n    if (a === \"slide\") keys.ControlLeft = 1;\n    if (a === \"jab\") punch(\"jab\");\n    if (a === \"fire\") primaryDown();\n  });\n  pads.addEventListener(\"pointerup\", function (e) {\n    keys.Space = 0; keys.ControlLeft = 0; primaryUp();\n  });\n\n  resetPlayer();\n  mode = \"title\";\n  requestAnimationFrame(frame);\n})();\n\u003c/script>\n\u003c/body>\n\u003c/html>\n");
