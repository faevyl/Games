  window.addEventListener('message', function(e){
    var msg = e.data;
    if(!msg || typeof msg !== 'object' || !msg.t) return;
    var frame = document.getElementById('proxyFrame');
    if(!frame || e.source !== frame.contentWindow) return;
    if(msg.t === 'fetch'){
      var id = msg.id;
      var opts = { method: msg.method, headers: msg.headers || {} };
      if(msg.binaryBody && msg.body){
        try{ opts.body = b64ToU8(msg.body); }catch(x){ opts.body = msg.body; }
      } else {
        opts.body = msg.body;
      }
      wispFetch(msg.url, opts).then(function(resp){
        handleWispFetchResponse(e.source, id, resp);
      }, function(err){
        try{ e.source.postMessage({ t:'fetch-err', id: id, msg: String((err && err.message) || err) }, '*'); }catch(x){}
      });
    } else if(msg.t === 'nav'){
      if(msg.url && msg.url !== tabs[activeTab].url) whyNavigate(msg.url);
    } else if(msg.t === 'open'){
      if(msg.url) whyNavigate(msg.url);
    } else if(msg.t === 'push'){
      if(msg.url) updateUrlBarFromPage(msg.url);
    } else if(msg.t === 'reload'){
      if(tabs[activeTab] && tabs[activeTab].url) wispLoad(tabs[activeTab].url);
    } else if(msg.t === 'ws-open'){
      wispWSOpen(e.source, msg);
    } else if(msg.t === 'ws-send'){
      wispWSSend(msg);
    } else if(msg.t === 'ws-close'){
      wispWSClose(msg);
    }
  });

