          else proxyResource(this);
        }
      };
    }catch(e){}
    if(window.MutationObserver){
      var mo = new MutationObserver(function(muts){
        for(var i = 0; i < muts.length; i++){
          var added = muts[i].addedNodes;
          for(var j = 0; j < added.length; j++){
            var n = added[j];
            if(n && n.nodeType === 1){
              if(n.tagName === 'LINK') proxyStylesheet(n);
              else proxyResource(n);
              scanTree(n);
            }
          }
        }
      });
      mo.observe(document, { childList: true, subtree: true });
    }
    scanTree(document);
    send({ t:'patcher-ready' });
  }
  var PATCHER_SOURCE = '(' + wispPatcher.toString() + ')(__WHY_BASE_URL__);';
  function injectPatcher(html, baseUrl){
    var script = '<script>' + PATCHER_SOURCE.replace('__WHY_BASE_URL__', JSON.stringify(baseUrl)) + '<\/script>';
    var base = '<base href="' + baseUrl + '">';
    if(/<head\b[^>]*>/i.test(html)){
      html = html.replace(/<head\b[^>]*>/i, function(m){ return m + base + script; });
    } else {
      html = '<head>' + base + script + '</head>' + html;
    }
    return html;
  }

  // parent side of the patcher message bus
  function handleWispFetchResponse(source, id, resp){
    resp.arrayBuffer().then(function(buf){
      var headers = {};
      try{ resp.headers.forEach(function(v, k){ headers[k] = v; }); }catch(e){}
      var ct = headers['content-type'] || '';
      var text = isTextType(ct);
      var payload = '';
      var charset = '';
      if(text){
        charset = getCharset(ct) || 'utf-8';
        var dec;
        try{ dec = new TextDecoder(charset); }catch(e){ dec = new TextDecoder('utf-8'); charset = 'utf-8'; }
        payload = dec.decode(buf);
      } else {
        payload = b64FromU8(new Uint8Array(buf));
      }
      try{
        source.postMessage({ t:'fetch-res', id: id, status: resp.status, statusText: resp.statusText, url: resp.url, headers: headers, body: payload, binary: !text, contentType: ct, charset: charset }, '*');
      }catch(e){}
    }, function(){
      try{ source.postMessage({ t:'fetch-err', id: id, msg: 'failed to read response' }, '*'); }catch(e){}
    });
  }
  function wispWSOpen(source, msg){
    if(!wispReady || typeof libcurl === 'undefined' || typeof libcurl.WebSocket === 'undefined'){
      try{ source.postMessage({ t:'ws-open-res', id: msg.id, ok: false }, '*'); }catch(e){}
      return;
    }
    var ws;
    try{ ws = new libcurl.WebSocket(msg.url, msg.protocols || []); }
    catch(e){ try{ source.postMessage({ t:'ws-open-res', id: msg.id, ok: false }, '*'); }catch(x){} return; }
    try{ ws.binaryType = 'arraybuffer'; }catch(e){}
    wispWSConns[msg.id] = ws;
    ws.addEventListener('open', function(){ try{ source.postMessage({ t:'ws-open-res', id: msg.id, ok: true }, '*'); }catch(e){} });
    ws.addEventListener('error', function(){ try{ source.postMessage({ t:'ws-open-res', id: msg.id, ok: false }, '*'); }catch(e){} });
    ws.addEventListener('message', function(ev){
      var d = ev.data;
      if(d && typeof d === 'object'){
        var u8 = new Uint8Array(d.buffer || d);
        try{ source.postMessage({ t:'ws-msg', id: msg.id, data: b64FromU8(u8), binary: true }, '*'); }catch(e){}
      } else {
        try{ source.postMessage({ t:'ws-msg', id: msg.id, data: String(d), binary: false }, '*'); }catch(e){}
      }
    });
    ws.addEventListener('close', function(ev){
      delete wispWSConns[msg.id];
      try{ source.postMessage({ t:'ws-close', id: msg.id, code: (ev && ev.code) || 1000 }, '*'); }catch(e){}
    });
  }
  function wispWSSend(msg){
    var ws = wispWSConns[msg.id];
    if(!ws) return;
    try{
      if(msg.binary){ ws.send(b64ToU8(msg.data)); }
      else ws.send(msg.data);
    }catch(e){}
  }
  function wispWSClose(msg){
    var ws = wispWSConns[msg.id];
    if(ws){ try{ ws.close(); }catch(e){} delete wispWSConns[msg.id]; }
  }

  // main page load pipeline
  function dispatchTransport(url){
    var token = ++navToken;
    if(settings.transport === 'wisp' && wispReady && !wispFail){
      wispLoad(url, token);
    } else if(settings.transport === 'wisp' && wispLoading && !wispFail){
      setStatus('wisp-connecting');
      var waited = 0;
      var iv = setInterval(function(){
        waited += 200;
        if(token !== navToken){ clearInterval(iv); return; }
        if(wispReady && !wispFail){ clearInterval(iv); wispLoad(url, token); }
        else if(wispFail || waited >= 6000){ clearInterval(iv); fallbackToRelay(url, token); }
      }, 200);
    } else {
      setStatus('loading');
      relayRender(url);
    }
  }
  function wispLoad(url, token){
    setStatus('loading');
    wispFetch(url).then(function(resp){
      if(token !== undefined && token !== navToken) return;
      renderWispResponse(url, resp, token);
    }, function(err){
      if(token !== undefined && token !== navToken) return;
      fallbackToRelay(url, token);
    });
  }
  function renderWispResponse(url, resp, token){
    var frame = document.getElementById('proxyFrame');
    var headers = {};
    var ct = '';
    try{ resp.headers.forEach(function(v, k){ headers[k] = v; }); ct = headers['content-type'] || ''; }catch(e){}
    resp.arrayBuffer().then(function(buf){
      if(token !== undefined && token !== navToken) return;
      var isHtml = /html/i.test(ct);
      var text = '';
      if(isHtml){
        var charset = getCharset(ct) || 'utf-8';
        var dec;
        try{ dec = new TextDecoder(charset); }catch(e){ dec = new TextDecoder('utf-8'); }
        text = dec.decode(buf);
      }
      if(isHtml && String(text).replace(/^\uFEFF/, '').trim().charAt(0) === '<'){
        text = rewriteHtml(text, url);
        text = injectPatcher(text, url);
        var title = extractTitle(text);
        if(title && tabs[activeTab]){ tabs[activeTab].title = title; updateTabs(); }
        if(frame){ frame.removeAttribute('src'); frame.srcdoc = text; frame.classList.add('active'); }
        setStatus('wisp');
      } else {
        // non-html content (image, pdf, video...) — show via blob url
        var type = ct.split(';')[0].trim() || 'application/octet-stream';
        var blob = new Blob([buf], { type: type });
        var objUrl = URL.createObjectURL(blob);
        if(frame){ frame.src = objUrl; frame.classList.add('active'); }
        setStatus('wisp');
      }
    }, function(){
      if(token !== undefined && token !== navToken) return;
      fallbackToRelay(url, token);
    });
  }
  function relayRender(url){
    var frame = document.getElementById('proxyFrame');
    if(frame){ frame.classList.add('active'); frame.src = buildRelayUrl(url); }
  }
  function fallbackToRelay(url, token){
    if(token !== undefined && token !== navToken) return;
    relayRender(url);
    setStatus('wisp-down');
    whyToast('wisp failed - using relays');
  }
