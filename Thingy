  // ── downloads (indexeddb) ──
  var DB_NAME = 'WhySingleDownloads';
  var DB_VER = 1;
  var db = null;
  function openDB(cb){
    if(db) return cb(db);
    var req = indexedDB.open(DB_NAME, DB_VER);
    req.onupgradeneeded = function(e){
      var d = e.target.result;
      if(!d.objectStoreNames.contains('downloads')){
        d.createObjectStore('downloads', { keyPath: 'id', autoIncrement: true });
      }
    };
    req.onsuccess = function(e){ db = e.target.result; cb(db); };
    req.onerror = function(){ cb(null); };
  }
  function addDownload(name, size, blob){
    openDB(function(d){
      if(!d) return;
      var tx = d.transaction('downloads', 'readwrite');
      tx.objectStore('downloads').add({ name: name, size: size, date: new Date().toISOString(), blob: blob });
    });
  }
  function getDownloads(cb){
    openDB(function(d){
      if(!d) return cb([]);
      var tx = d.transaction('downloads', 'readonly');
      var req = tx.objectStore('downloads').getAll();
      req.onsuccess = function(){ cb(req.result || []); };
      req.onerror = function(){ cb([]); };
    });
  }
  function deleteDownload(id){
    openDB(function(d){
      if(!d) return;
      var tx = d.transaction('downloads', 'readwrite');
      tx.objectStore('downloads').delete(id);
    });
    renderDownloads();
  }
  function renderDownloads(){
    getDownloads(function(dl){
      var el = document.getElementById('downloadList');
      if(!el) return;
      if(!dl || dl.length === 0){
        el.innerHTML = '<div class="dl-empty">No downloads yet</div>';
        return;
      }
      var html = '';
      dl.forEach(function(item){
        var sizeStr = item.size > 1048576 ? (item.size/1048576).toFixed(1)+'MB' : item.size > 1024 ? (item.size/1024).toFixed(1)+'KB' : item.size+'B';
        html += '<div class="dl-item">' +
          '<div class="dl-info"><div class="dl-name">' + escapeHtml(item.name) + '</div><div class="dl-meta"><span>' + sizeStr + '</span><span>' + (item.date || '') + '</span></div></div>' +
          '<div class="dl-actions">' +
          '<button onclick="whyOpenDownload(' + item.id + ')" title="Open">&#128065;</button>' +
          '<button onclick="whyDeleteDownload(' + item.id + ')" title="Delete">&#128465;</button>' +
          '</div></div>';
      });
      el.innerHTML = html;
    });
  }
  window.whyOpenDownload = function(id){
    openDB(function(d){
      if(!d) return;
      var tx = d.transaction('downloads', 'readonly');
      var req = tx.objectStore('downloads').get(id);
      req.onsuccess = function(){
        var item = req.result;
        if(item && item.blob){ var url = URL.createObjectURL(item.blob); window.open(url); }
      };
    });
  };
  window.whyDeleteDownload = function(id){ deleteDownload(id); };

  // ── cookies ──
  function renderCookies(){
    var el = document.getElementById('cookieList');
    if(!el) return;
    var cookies = document.cookie.split(';').filter(Boolean);
    if(cookies.length === 0){ el.innerHTML = '<div class="dl-empty">No cookies</div>'; return; }
    var html = '';
    cookies.forEach(function(c){
      var parts = c.trim().split('=');
      var name = parts[0];
      var value = parts.slice(1).join('=');
      html += '<div class="cookie-item"><span class="ci-name">' + escapeHtml(name) + '</span><span class="ci-value">' + escapeHtml(value) + '</span><button class="ci-del" onclick="whyDeleteCookie(\'' + escapeHtml(name) + '\')">&times;</button></div>';
    });
    el.innerHTML = html;
  }
  window.whyDeleteCookie = function(name){
    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
    renderCookies();
    whyToast('Cookie deleted');
  };
  window.whyClearAllCookies = function(){
    var cookies = document.cookie.split(';').filter(Boolean);
    cookies.forEach(function(c){
      var name = c.trim().split('=')[0];
      document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
    });
    renderCookies();
    whyToast('All cookies cleared');
  };

  // ── settings ui ──
  function applySettings(){
    document.documentElement.className = '';
    if(settings.theme && settings.theme !== '') document.documentElement.classList.add('theme-' + settings.theme);
    document.documentElement.classList.add('ui-' + settings.uiStyle);
    var bgPreview = document.getElementById('bgPreview');
    if(settings.customBg && bgPreview){
      bgPreview.style.backgroundImage = 'url(' + settings.customBg + ')';
      bgPreview.classList.add('show');
      document.getElementById('bgRemoveBtn').classList.add('show');
      document.body.style.backgroundImage = 'url(' + settings.customBg + ')';
      document.body.style.backgroundSize = 'cover';
      document.body.style.backgroundPosition = 'center';
    } else {
      document.body.style.backgroundImage = '';
      document.body.style.backgroundSize = '';
      document.body.style.backgroundPosition = '';
    }
  }

  function syncSettingsToUI(){
    document.getElementById('searchEngine').value = settings.searchEngine || 'brave';
    var rc = settings.relayChoice;
    if(['auto','allorigins','codetabs','thingproxy'].indexOf(rc) === -1) rc = 'auto';
    document.getElementById('relayChoice').value = rc;
    var tc = document.getElementById('transportChoice');
    if(tc) tc.value = settings.transport === 'relay' ? 'relay' : 'wisp';
    var ws = document.getElementById('wispServer');
    if(ws) ws.value = settings.wispServer || '';
    document.getElementById('blacklist').value = settings.blacklist || '';
    applySettings();
    updateTransportLabel();
  }
  function syncUIToSettings(){
    settings.searchEngine = document.getElementById('searchEngine').value;
    settings.relayChoice = document.getElementById('relayChoice').value;
    forcedRelay = settings.relayChoice;
    var tc = document.getElementById('transportChoice');
    if(tc) settings.transport = tc.value === 'relay' ? 'relay' : 'wisp';
    var ws = document.getElementById('wispServer');
    if(ws) settings.wispServer = ws.value.trim();
    settings.blacklist = document.getElementById('blacklist').value;
    saveSettings();
    nextRelay();
    if(settings.transport === 'wisp' && !wispReady && !wispFail && !wispLoading) initWisp();
    else if(settings.transport === 'wisp' && wispReady){
      try{ libcurl.set_websocket(getWispServer()); }catch(e){}
      setStatus('wisp');
    }
    else updateTransportLabel();
  }

  function initSettingsUI(){
    document.getElementById('searchEngine').addEventListener('change', syncUIToSettings);
    document.getElementById('relayChoice').addEventListener('change', syncUIToSettings);
    document.getElementById('blacklist').addEventListener('change', syncUIToSettings);
    var tc = document.getElementById('transportChoice');
    if(tc) tc.addEventListener('change', syncUIToSettings);
    var ws = document.getElementById('wispServer');
    if(ws) ws.addEventListener('change', syncUIToSettings);
    var preset = document.getElementById('wispPreset');
    if(preset) preset.addEventListener('change', function(){
      if(preset.value){
        var input = document.getElementById('wispServer');
        if(input) input.value = preset.value;
        syncUIToSettings();
        whyToast('wisp server updated');
      }
    });

    var THEMES = [
      { id:'gust', label:'Gust', bg:'#0b0d12', accent:'#7dd3c0' },
      { id:'sky', label:'Sky', bg:'#060618', accent:'#64b5f6' },
      { id:'purple', label:'Purple', bg:'#0a0a18', accent:'#a855f7' },
      { id:'matrix', label:'Matrix', bg:'#000a00', accent:'#00ff00' },
      { id:'midnight', label:'Midnight', bg:'#050520', accent:'#4488ff' },
      { id:'sunset', label:'Sunset', bg:'#0f0505', accent:'#ff6633' }
    ];
    var swatchContainer = document.getElementById('themeSwatches');
    THEMES.forEach(function(t){
      var sw = document.createElement('div');
      sw.className = 'theme-swatch' + (settings.theme === t.id ? ' active' : '');
      sw.style.background = 'linear-gradient(135deg, ' + t.bg + ', ' + t.accent + ')';
      sw.dataset.theme = t.id;
      sw.onclick = function(){
        settings.theme = t.id;
        saveSettings();
        applySettings();
        document.querySelectorAll('.theme-swatch').forEach(function(s){ s.classList.remove('active'); });
        sw.classList.add('active');
      };
      swatchContainer.appendChild(sw);
    });

    var UI_STYLES = [
      { id:'glass', label:'Glass' },
      { id:'sharp', label:'Sharp' },
      { id:'rounded', label:'Rounded' },
      { id:'minimal', label:'Minimal' }
    ];
    var uiChips = document.getElementById('uiStyleChips');
    UI_STYLES.forEach(function(s){
      var chip = document.createElement('button');
      chip.className = 'ui-style-chip' + (settings.uiStyle === s.id ? ' active' : '');
      chip.textContent = s.label;
      chip.dataset.style = s.id;
      chip.onclick = function(){
        settings.uiStyle = s.id;
        saveSettings();
        applySettings();
        document.querySelectorAll('.ui-style-chip').forEach(function(c){ c.classList.remove('active'); });
        chip.classList.add('active');
      };
      uiChips.appendChild(chip);
    });

    var bgInput = document.getElementById('bgUpload');
    bgInput.addEventListener('change', function(e){
      var file = e.target.files[0];
      if(!file) return;
      var reader = new FileReader();
      reader.onload = function(ev){
        settings.customBg = ev.target.result;
        saveSettings();
        applySettings();
        whyToast('Background set');
      };
      reader.readAsDataURL(file);
    });
    document.getElementById('bgRemoveBtn').onclick = function(){
      settings.customBg = '';
      saveSettings();
      applySettings();
      whyToast('Background removed');
    };

    syncSettingsToUI();
  }

  window.whyOpenSettings = function(){
    document.getElementById('settingsMask').classList.add('open');
    document.getElementById('settingsPanel').classList.add('open');
    renderCookies();
    renderDownloads();
  };
  window.whyCloseSettings = function(){
    document.getElementById('settingsMask').classList.remove('open');
    document.getElementById('settingsPanel').classList.remove('open');
  };
  window.whyResetSettings = function(){
    settings = JSON.parse(JSON.stringify(defaultSettings));
    forcedRelay = settings.relayChoice;
    saveSettings();
    syncSettingsToUI();
    if(settings.transport === 'wisp' && !wispReady && !wispFail && !wispLoading) initWisp();
    whyToast('Settings reset');
  };
  window.whyShowAbout = function(){
    document.getElementById('aboutOverlay').classList.add('open');
  };

  // settings tab nav
  document.querySelectorAll('.sp-nav-btn').forEach(function(btn){
    btn.onclick = function(){
      document.querySelectorAll('.sp-nav-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.sp-settings-tab').forEach(function(t){ t.classList.add('hidden'); });
      var tab = document.getElementById('tab-' + btn.dataset.tab);
      if(tab) tab.classList.remove('hidden');
    };
  });

  // bookmarks
  function renderBookmarkBar(){
    var bar = document.getElementById('bookmarkBar');
    if(!bar) return;
    if(bookmarks.length === 0){
      bar.classList.add('hidden');
      return;
    }
    bar.classList.remove('hidden');
    bar.innerHTML = '';
    bookmarks.forEach(function(bm){
      var pill = document.createElement('button');
      pill.className = 'bm-pill';
      pill.innerHTML = '<span class="bmi">\u2605</span>' + escapeHtml(bm.title || bm.url);
      pill.onclick = function(){ whyNavigate(bm.url); };
      bar.appendChild(pill);
    });
  }

  // toast
  var toastTimer = null;
  window.whyToast = function(msg){
    var el = document.getElementById('toast');
    if(!el) return;
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ el.classList.remove('show'); }, 2500);
  };

  function escapeHtml(s){
    if(!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  // keyboard shortcuts
  document.addEventListener('keydown', function(e){
    var ctrl = e.ctrlKey || e.metaKey;
    if(ctrl && (e.key === 'l' || e.key === 'L')){
      e.preventDefault();
      var input = document.getElementById('urlInput') || document.getElementById('homeSearch');
      if(input){ input.focus(); input.select(); }
    }
    if(ctrl && (e.key === 't' || e.key === 'T')){
      e.preventDefault();
      newTab();
    }
    if(ctrl && (e.key === 'w' || e.key === 'W')){
      e.preventDefault();
      closeTab(activeTab);
    }
    if(ctrl && (e.key === 'r' || e.key === 'R')){
      e.preventDefault();
      if(settings.transport === 'wisp' && wispReady && !wispFail && tabs[activeTab] && tabs[activeTab].url){
        wispLoad(tabs[activeTab].url);
      } else {
        var frame = document.getElementById('proxyFrame');
        if(frame && frame.src && frame.src !== 'about:blank'){
          frame.src = frame.src;
          setStatus('loading');
        }
      }
    }
    if(e.key === 'Escape'){
      whyCloseSettings();
      document.getElementById('aboutOverlay').classList.remove('open');
    }
  });

  // search mode pills
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.search-mode-btn');
    if(!btn) return;
    document.querySelectorAll('.search-mode-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    searchMode = btn.dataset.mode;
    try{ localStorage.setItem('why_single_search_mode', searchMode); }catch(err){}
  });

  // quick links
  document.addEventListener('click', function(e){
    var pill = e.target.closest('.ql-pill');
    if(!pill) return;
    whyNavigate(pill.dataset.url);
  });

  // init. a data: URL can finish parsing before this script runs, so
  // DOMContentLoaded has already fired and a listener would never run.
  function bootApp(){
    setTimeout(function(){
      var io = document.getElementById('introOverlay');
      if(io) io.classList.add('hidden');
    }, 1800);

    document.getElementById('homeSearch').addEventListener('keydown', function(e){
      if(e.key === 'Enter') whyNavigate(this.value);
    });
    document.getElementById('urlInput').addEventListener('keydown', function(e){
      if(e.key === 'Enter') whyNavigate(this.value);
    });
    document.getElementById('goBtn').onclick = function(){
      whyNavigate(document.getElementById('urlInput').value);
    };
    document.getElementById('backBtn').onclick = goBack;
    document.getElementById('fwdBtn').onclick = goForward;
    document.getElementById('refreshBtn').onclick = function(){
      if(settings.transport === 'wisp' && wispReady && !wispFail && tabs[activeTab] && tabs[activeTab].url){
        wispLoad(tabs[activeTab].url);
      } else {
        var frame = document.getElementById('proxyFrame');
        if(frame && frame.src && frame.src !== 'about:blank'){
          frame.src = frame.src;
          setStatus('loading');
        }
      }
    };
    document.getElementById('homeBtn').onclick = whyGoHome;

    var fileOpenBtn = document.getElementById('fileOpenBtn');
    var fileInput = document.getElementById('fileInput');
    if(fileOpenBtn && fileInput){
      fileOpenBtn.onclick = function(){ fileInput.click(); };
      fileInput.onchange = function(){
        var f = fileInput.files[0];
        if(!f) return;
        var url = URL.createObjectURL(f);
        loadProxy(url);
        whyToast('Opened: ' + f.name);
        fileInput.value = '';
      };
    }

    document.getElementById('fullscreenBtn').onclick = function(){
      if(!document.fullscreenElement){
        document.documentElement.requestFullscreen().catch(function(){});
      } else {
        document.exitFullscreen().catch(function(){});
      }
    };
    document.getElementById('settingsBtn').onclick = whyOpenSettings;
    document.getElementById('newTabBtn').onclick = newTab;
    document.getElementById('tabDropdownBtn').onclick = function(e){
      e.stopPropagation();
      document.getElementById('tabDropdownMenu').classList.toggle('open');
    };
    document.addEventListener('click', function(){
      document.getElementById('tabDropdownMenu').classList.remove('open');
    });
    document.getElementById('closeOtherTabs').onclick = closeOtherTabs;
    document.getElementById('closeAllTabs').onclick = closeAllTabs;
    document.getElementById('bookmarkBtn').onclick = function(){
      if(tabs[activeTab] && tabs[activeTab].url){
        bookmarks.push({ title: tabs[activeTab].title || tabs[activeTab].url, url: tabs[activeTab].url });
        saveBookmarks();
        renderBookmarkBar();
        whyToast('Bookmark added');
      }
    };

    function whyTickClock(){
      var el = document.getElementById('homeClock');
      if(!el) return;
      var d = new Date();
      el.textContent = d.toLocaleTimeString([], {hour:'numeric', minute:'2-digit'}) + '  \u00b7  ' + d.toLocaleDateString([], {weekday:'short', month:'short', day:'numeric'});
    }
    whyTickClock();
    setInterval(whyTickClock, 10000);
    var navMoreBtn = document.getElementById('navMoreBtn');
    var navMoreMenu = document.getElementById('navMoreMenu');
    if(navMoreBtn && navMoreMenu){
      navMoreBtn.onclick = function(e){
        e.stopPropagation();
        navMoreMenu.classList.toggle('open');
      };
      document.addEventListener('click', function(){ navMoreMenu.classList.remove('open'); });
    }
    initSettingsUI();
    renderBookmarkBar();
    updateTabs();
    updateNavButtons();
    applySettings();
    forcedRelay = settings.relayChoice;
    nextRelay();
    if(settings.transport === 'wisp') initWisp();
    updateTransportLabel();

    // Always start on homepage
    document.getElementById('homePage').classList.remove('hidden');
    var frame = document.getElementById('proxyFrame');
    if(frame) frame.classList.remove('active');
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootApp);
  else bootApp();
})();
</script>
</body>
</html>
